# Version control, editors, CI
.git
.gitignore
.gitattributes
.github
.vs
.vscode
.idea

# Build output and test artefacts
**/bin/
**/obj/
**/TestResults/
**/*.user
**/*.suo
**/*.trx

# Not needed to publish the API or Web app
tests/
docs/
containers/
*.md

# Local documentation and scratch files
*.log

# Local secrets and databases
.env
.env.*
!.env.example
**/appsettings.*.local.json
**/*.db
**/*.db-shm
**/*.db-wal

# Locally created runtime state: Data Protection key rings (and clinical images
# when Images__StoragePath points here) written by `dotnet run`.
**/App_Data/
