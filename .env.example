# =============================================================================
# DentalClinic — production environment template
#
# Copy to `.env` (git-ignored), fill every REQUIRED value, then:
#
#   docker compose -f docker-compose.prod.yml up -d --build
#
# The compose file reads this file automatically when it is named `.env` in the
# same directory. A variable marked `${VAR:?message}` there aborts the deploy
# with that message when it is missing, so a half-configured stack never boots.
# =============================================================================

# -----------------------------------------------------------------------------
# SQL Server
# -----------------------------------------------------------------------------
# REQUIRED. Password for the `sa` login. Must satisfy SQL Server's policy:
# at least 8 characters and 3 of: upper-case, lower-case, digit, symbol.
# Generate one, e.g.:  openssl rand -base64 32
SA_PASSWORD=

# -----------------------------------------------------------------------------
# JWT signing secret
# -----------------------------------------------------------------------------
# REQUIRED. Long-lived random secret used to sign access tokens. Changing it
# invalidates every issued token and refresh token (everyone is logged out).
# Never reuse the SQL password. Generate one, e.g.:  openssl rand -base64 64
JWT_SECRET=

# -----------------------------------------------------------------------------
# Public origin
# -----------------------------------------------------------------------------
# REQUIRED. The public HTTPS origin served by your reverse proxy, no trailing
# slash, e.g. https://clinic.example.com
# It is used as the CORS allow-list entry and as the JWT issuer/audience.
CORS_ALLOWED_ORIGIN=

# -----------------------------------------------------------------------------
# First-admin bootstrap (one-shot; delete after the first successful run)
# -----------------------------------------------------------------------------
# REQUIRED for `docker compose ... run --rm migrate --bootstrap-admin`.
# The password must satisfy the Identity policy: 12+ characters with an
# upper-case letter, a lower-case letter, a digit and a non-alphanumeric
# character. A weak password makes the bootstrap command exit non-zero with a
# message naming the policy.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Clinic profile (written to the singleton ClinicSetting row on --migrate)
# -----------------------------------------------------------------------------
# REQUIRED for the first boot. Seeded only when no clinic profile exists yet;
# afterwards the values are edited in the app's Settings page.
BOOTSTRAP_CLINIC_NAME=
BOOTSTRAP_CLINIC_NAME_ARABIC=

# IANA timezone id. Day windows, invoice years and appointment dates use it.
# Defaults to Asia/Damascus when empty.
BOOTSTRAP_TIMEZONE_ID=Asia/Damascus

# ISO-4217 code the money columns are stored in. Defaults to USD when empty.
BOOTSTRAP_BASE_CURRENCY=USD

# Dialling prefix used for WhatsApp links (963 for Syria). Optional.
BOOTSTRAP_DEFAULT_COUNTRY_CODE=963

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
# REQUIRED. Grafana admin password (the UI is bound to 127.0.0.1:3000 only).
GRAFANA_ADMIN_PASSWORD=

# REQUIRED. Seq admin password for the built-in `admin` user (the UI is bound
# to 127.0.0.1:8081 only). After the first boot, sign in to Seq, create an API
# key, put it in SEQ_API_KEY below and restart the API so its log stream is
# authenticated.
SEQ_ADMIN_PASSWORD=
SEQ_API_KEY=