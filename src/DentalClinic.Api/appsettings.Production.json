{
  // Production overrides. There are deliberately NO secrets and NO connection
  // strings in this file. Supply them at deploy time:
  //   ConnectionStrings__DefaultConnection  (SQL login, Encrypt=True)
  //   JwtSettings__Secret                   (long-lived random secret)
  //   Seq__ApiKey                           (only when Seq auth is enabled)
  //   AppSettings__AllowedOrigins__0        (real public web origin)
  // DNS/TLS is terminated by a reverse proxy in front of the containers; the
  // API trusts X-Forwarded-For/X-Forwarded-Proto from that proxy.
  "AllowedHosts": "*",

  "AppSettings": {
    "OpeningTime": "00:00",
    "ClosingTime": "23:59:59",
    "MaxSpots": 4,
    "MinimumAppointmentDurationInMinutes": 30,
    "LocalCacheExpirationInMins": 5,
    "DistributedCacheExpirationMins": 5,
    "DefaultPageNumber": 1,
    "DefaultPageSize": 10,
    "BookingCancellationThresholdMinutes": 15,
    "OverdueBookingCleanupFrequencyMinutes": 3,
    "CorsPolicyName": "DentalClinicApp",

    // Placeholder: override with AppSettings__AllowedOrigins__0=https://your-clinic-domain
    "AllowedOrigins": [ "https://clinic.example.com" ],

    // Explicit rather than relying on RateLimitSettings defaults, so a
    // production deploy is tuned on purpose.
    "RateLimiting": {
      "AuthPermitLimit": 10,
      "AuthWindowMinutes": 1,
      "GeneralPermitLimit": 100,
      "GeneralWindowMinutes": 1
    }
  },

  "Serilog": {
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": {
          // In-network Seq service name; override for an external sink.
          "serverUrl": "http://seq:5341"
        }
      }
    ],
    "Properties": {
      "Application": "api"
    }
  },

  "JwtSettings": {
    // Issuer/Audience are placeholders; set them to the public API origin via
    // JwtSettings__Issuer / JwtSettings__Audience. Changing them invalidates
    // every issued access token.
    "TokenExpirationInMinutes": 60,
    "Issuer": "https://clinic.example.com",
    "Audience": "https://clinic.example.com"
  },

  "InvoiceNumbering": {
    "Prefix": "INV",
    "Padding": 4
  },

  // Bootstrap values (Bootstrap__AdminEmail, Bootstrap__ClinicName, ...) are
  // supplied only for the one-shot --migrate / --bootstrap-admin commands and
  // removed from the environment afterwards. They are never committed here.
  "Bootstrap": {
    "//": "Supply via Bootstrap__* environment variables at bootstrap time only."
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}