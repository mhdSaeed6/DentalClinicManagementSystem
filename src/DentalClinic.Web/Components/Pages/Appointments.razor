@page "/appointments"
@inject ApiClient Api
@inject ClinicSessionState Session
@inject NotificationService Notifier
@inject NavigationManager Nav

<PageTitle>@Session.T("Appointments", "المواعيد") · @Session.T("Al Noor Dental", "عيادة النور")</PageTitle>

<PageHeader Title="@Session.T("Appointments", "المواعيد")"
            Subtitle="@Session.T("Schedule, reschedule and track every visit.", "جدولة وتعديل ومتابعة كل زيارة.")">
    <Actions>
        <button type="button" class="btn btn-outline" @onclick="LoadAsync" disabled="@_loading">
            <ClinicIcon Name="refresh" Class="sm" /><span>@Session.T("Refresh", "تحديث")</span>
        </button>
        <button type="button" class="btn btn-primary" @onclick="OpenCreate">
            <ClinicIcon Name="plus" Class="sm" /><span>@Session.T("New appointment", "موعد جديد")</span>
        </button>
    </Actions>
</PageHeader>

<div class="card">
    <div class="card-header" style="flex-wrap:wrap;gap:12px">
        <div class="flex gap-1 flex-wrap">
            <button type="button" class="chip @(_statusFilter is null ? "active" : "")" @onclick='() => SetStatus(null)'>@Session.T("All", "الكل")</button>
            @foreach (var (status, label) in StatusChips)
            {
                <button type="button" class="chip @(_statusFilter == status ? "active" : "")" @onclick="() => SetStatus(status)">@label</button>
            }
        </div>
        <div class="spacer" style="flex:1"></div>
        @if (!Session.IsDoctor)
        {
            <select class="select" style="max-width:200px" @bind="_doctorFilter" @bind:after="ApplyFilters">
                <option value="">@Session.T("All doctors", "كل الأطباء")</option>
                @foreach (var doctor in _doctors)
                {
                    <option value="@doctor.Id">@Session.T("Dr.", "د.") @FullName(doctor.FirstName, doctor.LastName)</option>
                }
            </select>
        }
        <select class="select" style="max-width:200px" @bind="_serviceFilter" @bind:after="ApplyFilters">
            <option value="">@Session.T("All services", "كل الخدمات")</option>
            @foreach (var service in _services)
            {
                <option value="@service.Id">@service.Name</option>
            }
        </select>
    </div>

    @if (_loading)
    {
        <div class="card-body">
            @for (var i = 0; i < 6; i++)
            {
                <div class="skeleton row"></div>
            }
        </div>
    }
    else if (Filtered.Count == 0)
    {
        <EmptyState Icon="calendar" Title="@Session.T("No appointments", "لا توجد مواعيد")"
                    Message="@Session.T("Book a visit to see it here.", "احجز موعداً ليظهر هنا.")">
            <ActionContent><button type="button" class="btn btn-primary" @onclick="OpenCreate"><ClinicIcon Name="plus" Class="sm" /> @Session.T("New appointment", "موعد جديد")</button></ActionContent>
        </EmptyState>
    }
    else
    {
        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th>@Session.T("When", "الموعد")</th>
                        <th>@Session.T("Patient", "المريض")</th>
                        <th>@Session.T("Doctor", "الطبيب")</th>
                        <th>@Session.T("Service", "الخدمة")</th>
                        <th>@Session.T("Status", "الحالة")</th>
                        <th style="text-align:end">@Session.T("Actions", "إجراءات")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var appt in Filtered)
                    {
                        <tr style="cursor:pointer" @onclick="() => OpenDetails(appt)">
                            <td>
                                <div class="cell-main">@ClinicFormatting.ShortDate(appt.ScheduledDateTime)</div>
                                <div class="cell-sub">@ClinicFormatting.TimeRange(appt.ScheduledDateTime, appt.DurationInMinutes)</div>
                            </td>
                            <td>
                                <div class="cell-person">
                                    <Avatar Name="@PatientName(appt.PatientId)" Size="sm" />
                                    <span class="cell-main">@PatientName(appt.PatientId)</span>
                                </div>
                            </td>
                            <td>@Session.T("Dr.", "د.") @DoctorName(appt.DoctorId)</td>
                            <td>@ServiceName(appt.ServiceId)</td>
                            <td><AppointmentStatusBadge Value="appt.Status" /></td>
                            <td @onclick:stopPropagation="true">
                                <div class="row-actions">
                                    <button type="button" class="btn btn-ghost btn-icon" title="@Session.T("View details", "عرض التفاصيل")" @onclick="() => OpenDetails(appt)">
                                        <ClinicIcon Name="eye" Class="sm" />
                                    </button>
                                    @if (appt.Status == AppointmentStatus.Scheduled)
                                    {
                                        <button type="button" class="btn btn-success-soft btn-sm" @onclick="() => OpenComplete(appt)">
                                            <ClinicIcon Name="check" Class="sm" /> @Session.T("Complete", "إكمال")
                                        </button>
                                        <button type="button" class="btn btn-ghost btn-icon" title="@Session.T("Reschedule", "إعادة جدولة")" @onclick="() => OpenReschedule(appt)">
                                            <ClinicIcon Name="refresh" Class="sm" />
                                        </button>
                                        <button type="button" class="btn btn-warning-soft btn-sm" @onclick="() => NoShowAsync(appt)">
                                            <ClinicIcon Name="user-x" Class="sm" /> @Session.T("No-show", "لم يحضر")
                                        </button>
                                        <button type="button" class="btn btn-danger-soft btn-sm" @onclick="() => CancelAsync(appt)">
                                            <ClinicIcon Name="x" Class="sm" /> @Session.T("Cancel", "إلغاء")
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="fs-xs text-soft">@Session.T("No actions", "لا إجراءات")</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <Pager PageNumber="_page" PageSize="_pageSize" TotalCount="_total" TotalPages="_totalPages" OnPageChange="GoToPage" />
    }
</div>

<Drawer IsOpen="_detailsOpen" Title="@DetailsTitle" Subtitle="@DetailsSubtitle" Icon="calendar"
        OnClose="CloseDetails">
    @if (_detailsLoading)
    {
        <div class="skeleton title"></div>
        @for (var i = 0; i < 6; i++)
        {
            <div class="skeleton row"></div>
        }
    }
    else if (_detailsError is not null)
    {
        <EmptyState Icon="alert" Title="@Session.T("Could not load appointment", "تعذّر تحميل الموعد")" Message="@_detailsError">
            <ActionContent>
                <button type="button" class="btn btn-outline" @onclick="RetryDetails">
                    <ClinicIcon Name="refresh" Class="sm" /> @Session.T("Retry", "إعادة المحاولة")
                </button>
            </ActionContent>
        </EmptyState>
    }
    else if (_detailsAppointment is { } appt)
    {
        <div class="flex-between mb-3" style="gap:12px;flex-wrap:wrap">
            <AppointmentStatusBadge Value="appt.Status" />
            <button type="button" class="btn btn-ghost btn-sm" @onclick="ViewPatientFromDetails">
                <ClinicIcon Name="user" Class="sm" /> @Session.T("View patient", "عرض المريض")
            </button>
        </div>

        <div class="complete-summary mb-3">
            <div class="summary-cell">
                <div class="label">@Session.T("When", "الموعد")</div>
                <div class="value">@ClinicFormatting.ShortDate(appt.ScheduledDateTime)</div>
            </div>
            <div class="summary-cell">
                <div class="label">@Session.T("Time", "الوقت")</div>
                <div class="value">@ClinicFormatting.TimeRange(appt.ScheduledDateTime, appt.DurationInMinutes)</div>
            </div>
            <div class="summary-cell">
                <div class="label">@Session.T("Duration", "المدة")</div>
                <div class="value">@appt.DurationInMinutes @Session.T("minutes", "دقيقة")</div>
            </div>
            <div class="summary-cell">
                <div class="label">@Session.T("Doctor", "الطبيب")</div>
                <div class="value">@Session.T("Dr.", "د.") @DoctorName(appt.DoctorId)</div>
            </div>
        </div>

        @if (appt.Status == AppointmentStatus.Scheduled)
        {
            <div class="flex flex-wrap gap-1 mb-3">
                <button type="button" class="btn btn-success-soft btn-sm" @onclick="CompleteFromDetails">
                    <ClinicIcon Name="check" Class="sm" /> @Session.T("Complete", "إكمال")
                </button>
                <button type="button" class="btn btn-outline btn-sm" @onclick="RescheduleFromDetails">
                    <ClinicIcon Name="refresh" Class="sm" /> @Session.T("Reschedule", "إعادة جدولة")
                </button>
                <button type="button" class="btn btn-warning-soft btn-sm" @onclick="NoShowFromDetails">
                    <ClinicIcon Name="user-x" Class="sm" /> @Session.T("No-show", "لم يحضر")
                </button>
                <button type="button" class="btn btn-danger-soft btn-sm" @onclick="CancelFromDetails">
                    <ClinicIcon Name="x" Class="sm" /> @Session.T("Cancel", "إلغاء")
                </button>
            </div>
        }

        <div class="card mb-3">
            <div class="card-body">
                <dl class="kv">
                    <dt>@Session.T("Patient", "المريض")</dt>
                    <dd>@PatientName(appt.PatientId)</dd>
                    <dt>@Session.T("Doctor", "الطبيب")</dt>
                    <dd>@Session.T("Dr.", "د.") @DoctorName(appt.DoctorId)</dd>
                    <dt>@Session.T("Service", "الخدمة")</dt>
                    <dd>
                        @if (appt.ServiceId is null)
                        {
                            <span class="text-muted">@Session.T("No service", "بدون خدمة")</span>
                        }
                        else
                        {
                            @ServiceName(appt.ServiceId)
                        }
                    </dd>
                    <dt>@Session.T("Date & time", "التاريخ والوقت")</dt>
                    <dd>@ClinicFormatting.DateTimeLabel(appt.ScheduledDateTime)</dd>
                    <dt>@Session.T("Duration", "المدة")</dt>
                    <dd>@appt.DurationInMinutes @Session.T("minutes", "دقيقة")</dd>
                    <dt>@Session.T("Notes", "ملاحظات")</dt>
                    <dd>@(string.IsNullOrWhiteSpace(appt.Notes) ? "—" : appt.Notes)</dd>
                </dl>
            </div>
        </div>

        <div class="complete-section mb-3">
            <div class="complete-section-title">
                <span>@Session.T("Treatments performed", "العلاجات المنفذة")</span>
                <span class="badge @(_detailsTreatments.Count > 0 ? "brand" : "muted") no-dot">@_detailsTreatments.Count</span>
            </div>
            @if (_treatmentsError is not null)
            {
                <div class="badge danger no-dot" style="display:flex;padding:10px 14px;border-radius:11px">
                    <ClinicIcon Name="alert" Class="sm" /><span>@_treatmentsError</span>
                </div>
            }
            else if (_detailsTreatments.Count == 0)
            {
                <div class="fs-xs text-soft">@Session.T("No treatments recorded for this appointment.", "لا توجد علاجات مسجّلة لهذا الموعد.")</div>
            }
            else
            {
                <div class="mb-2">
                    @foreach (var treatment in _detailsTreatments)
                    {
                        <div class="complete-treatment mb-1">
                            <span class="badge brand no-dot">@ClinicFormatting.ToothLabel(treatment.ToothNumber)</span>
                            <span class="treat-proc">@treatment.ProcedureDetails</span>
                            <span class="treat-cost">@ClinicFormatting.Money(treatment.Cost)</span>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="complete-section mb-3">
            <div class="complete-section-title">
                <span>@Session.T("Billing", "الفاتورة")</span>
            </div>

            @if (_billingError is not null)
            {
                <div class="badge danger no-dot mb-2" style="display:flex;padding:10px 14px;border-radius:11px">
                    <ClinicIcon Name="alert" Class="sm" /><span>@_billingError</span>
                </div>
            }

            @if (_generatedInvoiceId is { } generatedInvoiceId)
            {
                <div class="badge success no-dot mb-2" style="display:flex;padding:10px 14px;border-radius:11px">
                    <ClinicIcon Name="check" Class="sm" />
                    <span>@Session.T("Invoice draft is ready.", "مسودة الفاتورة جاهزة.")</span>
                </div>
                <button type="button" class="btn btn-outline btn-sm mb-2" @onclick="() => OpenGeneratedInvoice(generatedInvoiceId)">
                    <ClinicIcon Name="invoice" Class="sm" /> @Session.T("Open invoice", "فتح الفاتورة")
                </button>
            }

            <div class="list-row">
                <div class="list-body">
                    <div class="list-title">@ServiceName(appt.ServiceId)</div>
                    <div class="list-sub">@Session.T("Service charge", "قيمة الخدمة")</div>
                </div>
                <div class="treat-cost">@ServiceChargeLabel(appt.ServiceId)</div>
            </div>

            <div class="list-row">
                <div class="list-body">
                    <div class="list-title">@Session.T("Treatments", "العلاجات")</div>
                    <div class="list-sub">@_detailsTreatments.Count @Session.T("item(s)", "عنصر")</div>
                </div>
                <div class="treat-cost">@ClinicFormatting.Money(TreatmentSubtotal)</div>
            </div>

            <div class="list-row">
                <div class="list-body">
                    <div class="list-title fw-700">@Session.T("Estimated total", "الإجمالي التقديري")</div>
                    <div class="list-sub">@Session.T("Not yet invoiced", "لم تُفوتر بعد")</div>
                </div>
                <div class="treat-cost fw-700">@ClinicFormatting.Money(EstimatedTotal)</div>
            </div>

            @if (appt.Status == AppointmentStatus.Completed)
            {
                <button type="button" class="btn btn-primary btn-block mt-2" @onclick="GenerateInvoiceFromDetailsAsync" disabled="@_generatingInvoice">
                    @if (_generatingInvoice)
                    {
                        <span class="spinner"></span>
                    }
                    else
                    {
                        <ClinicIcon Name="invoice" Class="sm" />
                    }
                    <span>@Session.T("Generate invoice draft", "إنشاء مسودة الفاتورة")</span>
                </button>
            }
            else
            {
                <div class="fs-xs text-soft mt-2">@Session.T("Complete the appointment to generate its invoice.", "أكمل الموعد لإنشاء فاتورته.")</div>
            }
        </div>

        <div class="complete-section">
            <div class="complete-section-title">
                <span>@Session.T("Linked invoices", "الفواتير المرتبطة")</span>
                <span class="badge @(_detailsInvoices.Count > 0 ? "brand" : "muted") no-dot">@_detailsInvoices.Count</span>
            </div>
            @if (_invoicesError is not null)
            {
                <div class="badge danger no-dot" style="display:flex;padding:10px 14px;border-radius:11px">
                    <ClinicIcon Name="alert" Class="sm" /><span>@_invoicesError</span>
                </div>
            }
            else if (_detailsInvoices.Count == 0)
            {
                <div class="fs-xs text-soft">@Session.T("No invoices linked to this appointment.", "لا فواتير مرتبطة بهذا الموعد.")</div>
            }
            else
            {
                <div class="mb-2">
                    @foreach (var invoice in _detailsInvoices)
                    {
                        <div class="list-row">
                            <div class="list-body">
                                <div class="list-title mono">#@invoice.Id.ToString()[..8]</div>
                                <div class="list-sub">@ClinicFormatting.Money(invoice.TotalAmount) · @Session.T("Balance", "المتبقي") @ClinicFormatting.Money(invoice.RemainingAmount)</div>
                            </div>
                            <PaymentStatusBadge Value="invoice.Status" />
                        </div>
                    }
                </div>
            }
        </div>
    }
</Drawer>

<Modal IsOpen="_formOpen" Title="@Session.T("New appointment", "موعد جديد")"
       Subtitle="@Session.T("Pick a patient, doctor and time slot", "اختر المريض والطبيب والوقت")" OnClose="CloseForm">
    <ChildContent>
    @if (!string.IsNullOrWhiteSpace(_formError))
    {
        <div class="badge danger no-dot mb-2" style="display:flex;padding:10px 14px;border-radius:11px">
            <ClinicIcon Name="alert" Class="sm" /><span>@_formError</span>
        </div>
    }
    <div class="field">
        <label class="label">@Session.T("Patient", "المريض") <span class="req">*</span></label>
        <select class="select" @bind="_form.PatientId">
            <option value="@Guid.Empty">@Session.T("— Select patient —", "— اختر المريض —")</option>
            @foreach (var patient in _patients)
            {
                <option value="@patient.Id">@FullName(patient.FirstName, patient.LastName) · @patient.PrimaryPhone</option>
            }
        </select>
    </div>
    <div class="form-grid">
        <div class="field">
            <label class="label">@Session.T("Doctor", "الطبيب") <span class="req">*</span></label>
            <select class="select" @bind="_form.DoctorId" disabled="@Session.IsDoctor">
                <option value="@Guid.Empty">@Session.T("— Select —", "— اختر —")</option>
                @foreach (var doctor in _doctors)
                {
                    <option value="@doctor.Id">@Session.T("Dr.", "د.") @FullName(doctor.FirstName, doctor.LastName)</option>
                }
            </select>
        </div>
        <div class="field">
            <label class="label">@Session.T("Service (optional)", "الخدمة (اختياري)")</label>
            <select class="select" @bind="_form.ServiceId">
                <option value="">@Session.T("— No service —", "— بدون خدمة —")</option>
                @foreach (var service in _services)
                {
                    <option value="@service.Id">@service.Name (@ClinicFormatting.Money(service.Price))</option>
                }
            </select>
        </div>
        <div class="field">
            <label class="label">@Session.T("Date & time", "التاريخ والوقت") <span class="req">*</span></label>
            <input type="datetime-local" class="input"
                   value="@_form.ScheduledDateTime.ToString("yyyy-MM-ddTHH:mm")"
                   @onchange="OnScheduleChanged" />
        </div>
        <div class="field">
            <label class="label">@Session.T("Duration (minutes)", "المدة (دقائق)")</label>
            <input type="number" min="15" max="240" step="15" class="input" @bind="_form.DurationInMinutes" />
        </div>
    </div>
    <div class="field">
        <label class="label">@Session.T("Notes", "ملاحظات")</label>
        <textarea class="textarea" @bind="_form.Notes" placeholder="@Session.T("e.g. Routine checkup", "مثال: فحص روتيني")"></textarea>
    </div>
    </ChildContent>

    <Footer>
        <button type="button" class="btn btn-ghost" @onclick="CloseForm">@Session.T("Cancel", "إلغاء")</button>
        <button type="button" class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">
            @if (_saving)
            {
                <span class="spinner"></span>
            }
            else
            {
                <ClinicIcon Name="check" Class="sm" />
            }
            <span>@Session.T("Book appointment", "احجز الموعد")</span>
        </button>
    </Footer>
</Modal>

<Modal IsOpen="_rescheduleOpen" Title="@Session.T("Reschedule appointment", "إعادة جدولة الموعد")"
       Subtitle="@_rescheduleName" OnClose="() => _rescheduleOpen = false">
    <ChildContent>
    @if (!string.IsNullOrWhiteSpace(_formError))
    {
        <div class="badge danger no-dot mb-2" style="display:flex;padding:10px 14px;border-radius:11px">
            <ClinicIcon Name="alert" Class="sm" /><span>@_formError</span>
        </div>
    }
    <div class="form-grid">
        <div class="field">
            <label class="label">@Session.T("New date & time", "التاريخ والوقت الجديد")</label>
            <input type="datetime-local" class="input"
                   value="@_reschedule.NewScheduledDateTime.ToString("yyyy-MM-ddTHH:mm")"
                   @onchange="OnRescheduleChanged" />
        </div>
        <div class="field">
            <label class="label">@Session.T("Duration (minutes)", "المدة (دقائق)")</label>
            <input type="number" min="15" max="240" step="15" class="input" @bind="_reschedule.DurationInMinutes" />
        </div>
    </div>
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-ghost" @onclick="() => _rescheduleOpen = false">@Session.T("Cancel", "إلغاء")</button>
        <button type="button" class="btn btn-primary" @onclick="SaveRescheduleAsync" disabled="@_saving">
            @if (_saving)
            {
                <span class="spinner"></span>
            }
            <span>@Session.T("Reschedule", "إعادة الجدولة")</span>
        </button>
    </Footer>
</Modal>

<Modal IsOpen="_completeOpen" Size="lg" Title="@Session.T("Complete appointment", "إكمال الموعد")"
       Subtitle="@CompleteSubtitle" OnClose="CloseComplete">
    <ChildContent>
    @if (!string.IsNullOrWhiteSpace(_completeError))
    {
        <div class="badge danger no-dot mb-2" style="display:flex;padding:10px 14px;border-radius:11px">
            <ClinicIcon Name="alert" Class="sm" /><span>@_completeError</span>
        </div>
    }

    @if (_completeAppointment is not null)
    {
        <div class="complete-summary mb-3">
            <div class="summary-cell">
                <div class="label">@Session.T("Patient", "المريض")</div>
                <div class="value">@PatientName(_completeAppointment.PatientId)</div>
            </div>
            <div class="summary-cell">
                <div class="label">@Session.T("Doctor", "الطبيب")</div>
                <div class="value">@Session.T("Dr.", "د.") @DoctorName(_completeAppointment.DoctorId)</div>
            </div>
            <div class="summary-cell">
                <div class="label">@Session.T("When", "الموعد")</div>
                <div class="value">@ClinicFormatting.DateTimeLabel(_completeAppointment.ScheduledDateTime)</div>
            </div>
            <div class="summary-cell service-cell">
                <label class="label" for="completeService">@Session.T("Service performed", "الخدمة المنفذة")</label>
                <select id="completeService" class="select" @bind="_completeServiceId">
                    @if (_completeAppointment.ServiceId is null)
                    {
                        <option value="">@Session.T("— No service —", "— بدون خدمة —")</option>
                    }
                    @foreach (var service in _services)
                    {
                        <option value="@service.Id">@service.Name (@ClinicFormatting.Money(service.Price))</option>
                    }
                </select>
            </div>
            @if (!string.IsNullOrWhiteSpace(_completeAppointment.Notes))
            {
                <div class="summary-cell span-all">
                    <div class="label">@Session.T("Notes", "ملاحظات")</div>
                    <div class="value">@_completeAppointment.Notes</div>
                </div>
            }
        </div>

        <div class="complete-note mb-3">
            <ClinicIcon Name="info" Class="sm" />
            <span>@Session.T("Changing the service only updates this visit — it never adds or removes the treatment records below.", "تغيير الخدمة يحدّث هذه الزيارة فقط — ولا يضيف أو يحذف سجلات العلاج أدناه.")</span>
        </div>

        <div class="complete-section">
            <div class="complete-section-title">
                <span>@Session.T("Treatments performed", "العلاجات المنفذة")</span>
                <span class="badge @(_completeTreatments.Count > 0 ? "brand" : "muted") no-dot">@_completeTreatments.Count</span>
            </div>
            <div class="complete-hint">
                @Session.T("Add every treatment performed during this visit. Leave it empty for a consultation-only visit.", "أضف كل علاج تم أثناء الزيارة. اتركه فارغاً لزيارة استشارية فقط.")
            </div>

            @if (_completeTreatments.Count == 0)
            {
                <div class="fs-xs text-soft mb-2">@Session.T("No treatments added yet — the visit will be recorded as consultation only.", "لا علاجات بعد — ستُسجَّل الزيارة كاستشارة فقط.")</div>
            }
            else
            {
                <div class="mb-2">
                    @for (var i = 0; i < _completeTreatments.Count; i++)
                    {
                        var index = i;
                        <div class="complete-treatment mb-1">
                            <span class="badge brand no-dot">@ClinicFormatting.ToothLabel(_completeTreatments[index].ToothNumber)</span>
                            <span class="treat-proc">@_completeTreatments[index].ProcedureDetails</span>
                            <span class="treat-cost">@ClinicFormatting.Money(_completeTreatments[index].Cost)</span>
                            <button type="button" class="btn btn-ghost btn-icon" title="@Session.T("Remove", "إزالة")" @onclick="() => RemoveCompleteTreatment(index)">
                                <ClinicIcon Name="x" Class="sm" />
                            </button>
                        </div>
                    }
                </div>
            }

            <div class="complete-add-title">
                <span>@Session.T("Add a treatment", "إضافة علاج")</span>
                <span class="badge brand no-dot">@ClinicFormatting.ToothLabel(_completeTooth)</span>
            </div>

            <ToothChart @bind-Value="_completeTooth" />

            <div class="complete-add">
                <div class="field">
                    <label class="label">@Session.T("Procedure details", "تفاصيل الإجراء") <span class="req">*</span></label>
                    <textarea class="textarea" rows="2" @bind="_completeProcedure" placeholder="@Session.T("Describe what was performed…", "صف ما تم إجراؤه…")"></textarea>
                </div>
                <div class="field">
                    <label class="label">@Session.T("Cost (USD)", "التكلفة (دولار)")</label>
                    <input type="number" step="0.01" min="0" class="input" @bind="_completeCost" />
                </div>
            </div>

            <div class="complete-actions">
                <button type="button" class="btn btn-outline" @onclick="AddCompleteTreatment">
                    <ClinicIcon Name="plus" Class="sm" /> @Session.T("Add treatment to this visit", "إضافة علاج للزيارة")
                </button>
            </div>
        </div>
    }
    </ChildContent>

    <Footer>
        <button type="button" class="btn btn-ghost" @onclick="CloseComplete">@Session.T("Cancel", "إلغاء")</button>
        <button type="button" class="btn btn-success-soft" @onclick="ConfirmCompleteAsync" disabled="@_saving">
            @if (_saving)
            {
                <span class="spinner"></span>
            }
            else
            {
                <ClinicIcon Name="check" Class="sm" />
            }
            <span>@Session.T("Complete appointment", "إكمال الموعد")</span>
        </button>
    </Footer>
</Modal>

@code {
    private List<AppointmentDto> _appointments = [];
    private List<PatientDto> _patients = [];
    private List<DoctorDto> _doctors = [];
    private List<DentalServiceDto> _services = [];

    private int _page = 1;
    private int _pageSize = 10;
    private int _total;
    private int _totalPages;
    private bool _loading = true;

    private AppointmentStatus? _statusFilter;
    private Guid? _doctorFilter;
    private Guid? _serviceFilter;

    private bool _formOpen;
    private bool _rescheduleOpen;
    private bool _saving;
    private string? _formError;
    private string _rescheduleName = string.Empty;
    private Guid _rescheduleId;
    private AppointmentFormRequest _form = new();
    private RescheduleAppointmentRequest _reschedule = new();

    private bool _completeOpen;
    private AppointmentDto? _completeAppointment;
    private string? _completeError;
    private List<CompleteAppointmentTreatmentRequest> _completeTreatments = [];
    private int _completeTooth = 11;
    private string _completeProcedure = string.Empty;
    private decimal _completeCost;
    private Guid? _completeServiceId;

    private bool _detailsOpen;
    private bool _detailsLoading;
    private AppointmentDto? _detailsAppointment;
    private List<TreatmentRecordDto> _detailsTreatments = [];
    private List<InvoiceDto> _detailsInvoices = [];
    private string? _detailsError;
    private string? _treatmentsError;
    private string? _invoicesError;

    /// <summary>Billing block: live estimate, the generate action and its result.</summary>
    private string? _billingError;
    private bool _generatingInvoice;
    private Guid? _generatedInvoiceId;

    /// <summary>Estimated service charge from the selected service's current price (0 when none).</summary>
    private decimal ServiceSubtotal =>
        _detailsAppointment?.ServiceId is { } serviceId
            ? _services.FirstOrDefault(s => s.Id == serviceId)?.Price ?? 0m
            : 0m;

    /// <summary>Sum of this appointment's treatment costs.</summary>
    private decimal TreatmentSubtotal => _detailsTreatments.Sum(t => t.Cost);

    private decimal EstimatedTotal => ServiceSubtotal + TreatmentSubtotal;

    /// <summary>Guards against a slow load for a previously selected appointment overwriting a newer one.</summary>
    private int _detailsRequestId;

    private IEnumerable<(AppointmentStatus Status, string Label)> StatusChips =>
    [
        (AppointmentStatus.Scheduled, Session.T("Scheduled", "محجوز")),
        (AppointmentStatus.Completed, Session.T("Completed", "مكتمل")),
        (AppointmentStatus.Cancelled, Session.T("Cancelled", "ملغى")),
        (AppointmentStatus.NoShow, Session.T("No-show", "لم يحضر")),
    ];

    private List<AppointmentDto> Filtered => _statusFilter is null
        ? _appointments
        : _appointments.Where(a => a.Status == _statusFilter).ToList();

    protected override async Task OnInitializedAsync()
    {
        var query = NavQuery.Parse(Nav.Uri);
        await LoadLookupsAsync();
        await LoadAsync();

        if (query.TryGetValue("patient", out var patientId) && Guid.TryParse(patientId, out var pid))
        {
            _form.PatientId = pid;
        }

        if (query.ContainsKey("new"))
        {
            OpenCreate();
        }
    }

    private async Task LoadLookupsAsync()
    {
        try
        {
            var patientsTask = Api.GetPatientsAsync(1, 100, null);
            var doctorsTask = Api.GetDoctorsAsync(1, 100, null);
            var servicesTask = Api.GetServicesAsync(1, 100, null);
            await Task.WhenAll(patientsTask, doctorsTask, servicesTask);

            _patients = (await patientsTask).Items ?? [];
            _doctors = (await doctorsTask).Items ?? [];
            _services = (await servicesTask).Items ?? [];
        }
        catch
        {
            // lookups are best-effort
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            var result = await Api.GetAppointmentsAsync(_page, _pageSize, null, _doctorFilter, _serviceFilter);
            _appointments = result.Items ?? [];
            _total = result.TotalCount;
            _totalPages = result.TotalPages;
        }
        catch (ApiException ex)
        {
            Notifier.Error(Session.T("Could not load appointments", "تعذّر تحميل المواعيد"), ex.Message);
            _appointments = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ApplyFilters()
    {
        _page = 1;
        await LoadAsync();
    }

    private async Task SetStatus(AppointmentStatus? status)
    {
        _statusFilter = status;
        await Task.CompletedTask;
    }

    private async Task GoToPage(int page)
    {
        _page = page;
        await LoadAsync();
    }

    private void OpenCreate()
    {
        _form = new AppointmentFormRequest();

        // A doctor books visits for themselves only; the API enforces the same rule.
        if (Session.IsDoctor && Session.DoctorId is { } ownDoctorId)
        {
            _form.DoctorId = ownDoctorId;
        }

        _formError = null;
        _formOpen = true;
    }

    private void CloseForm()
    {
        _formOpen = false;
        _formError = null;
    }

    private void OpenReschedule(AppointmentDto appointment)
    {
        _rescheduleId = appointment.Id;
        _rescheduleName = $"{PatientName(appointment.PatientId)} · {ClinicFormatting.DateTimeLabel(appointment.ScheduledDateTime)}";
        _reschedule = new RescheduleAppointmentRequest
        {
            NewScheduledDateTime = appointment.ScheduledDateTime,
            DurationInMinutes = appointment.DurationInMinutes,
        };
        _formError = null;
        _rescheduleOpen = true;
    }

    private void OnScheduleChanged(ChangeEventArgs args)
    {
        if (DateTime.TryParse(args.Value?.ToString(), out var date))
        {
            _form.ScheduledDateTime = date;
        }
    }

    private void OnRescheduleChanged(ChangeEventArgs args)
    {
        if (DateTime.TryParse(args.Value?.ToString(), out var date))
        {
            _reschedule.NewScheduledDateTime = date;
        }
    }

    private async Task SaveAsync()
    {
        _formError = null;

        if (_form.PatientId == Guid.Empty || _form.DoctorId == Guid.Empty)
        {
            _formError = Session.T("Please select a patient and doctor.", "الرجاء اختيار المريض والطبيب.");
            return;
        }

        _saving = true;
        try
        {
            await Api.CreateAppointmentAsync(_form);
            Notifier.Success(Session.T("Appointment booked", "تم حجز الموعد"));
            CloseForm();
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            _formError = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task SaveRescheduleAsync()
    {
        _saving = true;
        _formError = null;
        try
        {
            await Api.RescheduleAppointmentAsync(_rescheduleId, _reschedule);
            Notifier.Success(Session.T("Appointment rescheduled", "تمت إعادة جدولة الموعد"));
            _rescheduleOpen = false;
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            _formError = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private string CompleteSubtitle => _completeAppointment is { } appointment
        ? $"{PatientName(appointment.PatientId)} · {ClinicFormatting.DateTimeLabel(appointment.ScheduledDateTime)}"
        : Session.T("Review the visit before completing it.", "راجع الزيارة قبل إكمالها.");

    private void OpenComplete(AppointmentDto appointment)
    {
        _completeAppointment = appointment;
        _completeServiceId = appointment.ServiceId;
        _completeTreatments = [];
        _completeTooth = 11;
        _completeProcedure = string.Empty;
        _completeCost = 0;
        _completeError = null;
        _completeOpen = true;
    }

    private void CloseComplete()
    {
        _completeOpen = false;
        _completeAppointment = null;
        _completeError = null;
    }

    private void AddCompleteTreatment()
    {
        _completeError = null;

        if (string.IsNullOrWhiteSpace(_completeProcedure))
        {
            _completeError = Session.T("Procedure details are required.", "تفاصيل الإجراء مطلوبة.");
            return;
        }

        _completeTreatments.Add(new CompleteAppointmentTreatmentRequest
        {
            ToothNumber = _completeTooth,
            ProcedureDetails = _completeProcedure.Trim(),
            Cost = _completeCost,
        });

        _completeProcedure = string.Empty;
        _completeCost = 0;
        _completeTooth = 11;
    }

    private void RemoveCompleteTreatment(int index)
    {
        if (index >= 0 && index < _completeTreatments.Count)
        {
            _completeTreatments.RemoveAt(index);
        }
    }

    private async Task ConfirmCompleteAsync()
    {
        if (_completeAppointment is null)
        {
            return;
        }

        _saving = true;
        _completeError = null;
        try
        {
            var request = new CompleteAppointmentRequest
            {
                Treatments = _completeTreatments.Count > 0 ? _completeTreatments : null,
                ServiceId = _completeServiceId,
            };

            await Api.CompleteAppointmentAsync(_completeAppointment.Id, request);
            Notifier.Success(Session.T("Appointment completed", "تم إكمال الموعد"));
            CloseComplete();
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            _completeError = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task CancelAsync(AppointmentDto appointment)
    {
        try
        {
            await Api.CancelAppointmentAsync(appointment.Id);
            Notifier.Info(Session.T("Appointment cancelled", "تم إلغاء الموعد"));
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Notifier.Error(Session.T("Action failed", "فشل الإجراء"), ex.Message);
        }
    }

    private async Task NoShowAsync(AppointmentDto appointment)
    {
        try
        {
            await Api.MarkNoShowAppointmentAsync(appointment.Id);
            Notifier.Warning(Session.T("Appointment marked as no-show", "تم تحديد الموعد كعدم حضور"));
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Notifier.Error(Session.T("Action failed", "فشل الإجراء"), ex.Message);
        }
    }

    // ------------------------------------------------------- Details drawer

    private string DetailsTitle => _detailsAppointment is { } appt
        ? PatientName(appt.PatientId)
        : Session.T("Appointment", "الموعد");

    private string DetailsSubtitle => _detailsAppointment is { } appt
        ? ClinicFormatting.DateTimeLabel(appt.ScheduledDateTime)
        : Session.T("Appointment details", "تفاصيل الموعد");

    private async Task OpenDetails(AppointmentDto appointment)
    {
        // Surface the known appointment immediately, then refresh from the API so a
        // deleted or reassigned appointment is reported instead of silently stale data.
        _detailsAppointment = appointment;
        _detailsTreatments = [];
        _detailsInvoices = [];
        _detailsError = null;
        _treatmentsError = null;
        _invoicesError = null;
        _billingError = null;
        _generatedInvoiceId = null;
        _detailsLoading = true;
        _detailsOpen = true;
        StateHasChanged();

        await LoadDetailsAsync(appointment.Id);
    }

    private async Task RetryDetails()
    {
        if (_detailsAppointment is null)
        {
            return;
        }

        _detailsLoading = true;
        StateHasChanged();
        await LoadDetailsAsync(_detailsAppointment.Id);
    }

    private async Task LoadDetailsAsync(Guid appointmentId)
    {
        var requestId = ++_detailsRequestId;

        _detailsError = null;
        _treatmentsError = null;
        _invoicesError = null;
        _billingError = null;

        try
        {
            var appointment = await Api.GetAppointmentAsync(appointmentId);
            if (requestId != _detailsRequestId)
            {
                return;
            }

            _detailsAppointment = appointment;
        }
        catch (ApiException ex)
        {
            if (requestId != _detailsRequestId)
            {
                return;
            }

            _detailsError = ex.Message;
            _detailsLoading = false;
            return;
        }
        catch (Exception)
        {
            if (requestId != _detailsRequestId)
            {
                return;
            }

            _detailsError = Session.T("Unable to load this appointment.", "تعذّر تحميل هذا الموعد.");
            _detailsLoading = false;
            return;
        }

        // Only records that belong to this appointment are requested from the API.
        try
        {
            var treatments = await Api.GetTreatmentRecordsAsync(1, 100, appointmentId: appointmentId);
            if (requestId != _detailsRequestId)
            {
                return;
            }

            _detailsTreatments = treatments.Items ?? [];
        }
        catch (ApiException ex)
        {
            if (requestId != _detailsRequestId)
            {
                return;
            }

            _treatmentsError = ex.Message;
        }
        catch (Exception)
        {
            if (requestId != _detailsRequestId)
            {
                return;
            }

            _treatmentsError = Session.T("Unable to load treatments.", "تعذّر تحميل العلاجات.");
        }

        try
        {
            var invoices = await Api.GetInvoicesAsync(1, 100, appointmentId: appointmentId);
            if (requestId != _detailsRequestId)
            {
                return;
            }

            _detailsInvoices = invoices.Items ?? [];
        }
        catch (ApiException ex)
        {
            if (requestId != _detailsRequestId)
            {
                return;
            }

            _invoicesError = ex.Message;
        }
        catch (Exception)
        {
            if (requestId != _detailsRequestId)
            {
                return;
            }

            _invoicesError = Session.T("Unable to load invoices.", "تعذّر تحميل الفواتير.");
        }

        if (requestId != _detailsRequestId)
        {
            return;
        }

        _detailsLoading = false;
    }

    private void CloseDetails()
    {
        // Invalidate any in-flight load so its result cannot repopulate a closed drawer.
        _detailsRequestId++;
        _detailsOpen = false;
        _detailsLoading = false;
        _detailsAppointment = null;
        _detailsTreatments = [];
        _detailsInvoices = [];
        _detailsError = null;
        _treatmentsError = null;
        _invoicesError = null;
        _billingError = null;
        _generatingInvoice = false;
        _generatedInvoiceId = null;
    }

    private void ViewPatientFromDetails()
    {
        if (_detailsAppointment is { } appt)
        {
            Nav.NavigateTo($"patients/{appt.PatientId}");
        }
    }

    private void CompleteFromDetails()
    {
        if (_detailsAppointment is not { } appt)
        {
            return;
        }

        // Reuse the existing completion flow; close this drawer first so we never
        // stack two overlays.
        CloseDetails();
        OpenComplete(appt);
    }

    private void RescheduleFromDetails()
    {
        if (_detailsAppointment is not { } appt)
        {
            return;
        }

        CloseDetails();
        OpenReschedule(appt);
    }

    private async Task NoShowFromDetails()
    {
        if (_detailsAppointment is not { } appt)
        {
            return;
        }

        await NoShowAsync(appt);
        await RefreshDetailsAsync(appt.Id);
    }

    private async Task CancelFromDetails()
    {
        if (_detailsAppointment is not { } appt)
        {
            return;
        }

        await CancelAsync(appt);
        await RefreshDetailsAsync(appt.Id);
    }

    private async Task RefreshDetailsAsync(Guid appointmentId)
    {
        if (!_detailsOpen)
        {
            return;
        }

        _detailsLoading = true;
        StateHasChanged();
        await LoadDetailsAsync(appointmentId);
    }

    /// <summary>
    /// Generates (or returns) the invoice draft for this appointment. The call is
    /// guarded against double submits and the endpoint is idempotent server-side.
    /// </summary>
    private async Task GenerateInvoiceFromDetailsAsync()
    {
        if (_detailsAppointment is not { } appt || _generatingInvoice)
        {
            return;
        }

        _generatingInvoice = true;
        _billingError = null;
        _generatedInvoiceId = null;
        StateHasChanged();

        try
        {
            var result = await Api.GenerateAppointmentInvoiceAsync(appt.Id);
            _generatedInvoiceId = result.InvoiceId;

            Notifier.Success(result.ReusedExisting
                ? Session.T("An invoice already exists for this visit.", "توجد فاتورة بالفعل لهذا الموعد.")
                : Session.T("Invoice draft created.", "تم إنشاء مسودة الفاتورة."));

            // Refresh the linked-invoice list so the new draft appears immediately.
            await LoadDetailsAsync(appt.Id);
        }
        catch (ApiException ex)
        {
            _billingError = ex.Message;
        }
        catch (Exception)
        {
            _billingError = Session.T("Unable to generate the invoice.", "تعذّر إنشاء الفاتورة.");
        }
        finally
        {
            _generatingInvoice = false;
            StateHasChanged();
        }
    }

    private void OpenGeneratedInvoice(Guid invoiceId) =>
        Nav.NavigateTo($"invoices?invoice={invoiceId}");

    private string FullName(string? first, string? last) => ClinicFormatting.FullName(first, last);

    private string PatientName(Guid id) =>
        _patients.FirstOrDefault(p => p.Id == id) is { } patient
            ? FullName(patient.FirstName, patient.LastName)
            : Session.T("Unknown patient", "مريض غير معروف");

    private string DoctorName(Guid id) =>
        _doctors.FirstOrDefault(d => d.Id == id) is { } doctor
            ? FullName(doctor.FirstName, doctor.LastName)
            : Session.T("Unassigned", "غير مُعيّن");

    private string ServiceName(Guid? id) =>
        id is { } serviceId
            ? _services.FirstOrDefault(s => s.Id == serviceId)?.Name ?? Session.T("Service", "خدمة")
            : Session.T("No service", "بدون خدمة");

    /// <summary>
    /// The known service charge, or an em dash when there is no service or its
    /// price cannot be resolved — never a fabricated amount.
    /// </summary>
    private string ServiceChargeLabel(Guid? id) =>
        id is { } serviceId
            ? _services.FirstOrDefault(s => s.Id == serviceId) is { } service
                ? ClinicFormatting.Money(service.Price)
                : "—"
            : "—";
}
