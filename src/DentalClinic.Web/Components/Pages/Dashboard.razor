@page "/"
@inject ApiClient Api
@inject ClinicSessionState Session
@inject ClinicBranding Branding
@inject NotificationService Notifier
@inject NavigationManager Nav

<PageTitle>@Session.T("Dashboard", "لوحة التحكم") · @Branding.DisplayName(Session.IsRtl)</PageTitle>

@if (_loading)
{
    <div class="stat-grid">
        @for (var i = 0; i < 4; i++)
        {
            <div class="skeleton stat"></div>
        }
    </div>
    <div class="grid grid-2-1">
        <div class="card"><div class="card-body">
            <div class="skeleton title"></div>
            @for (var i = 0; i < 5; i++)
            {
                <div class="skeleton row"></div>
            }
        </div></div>
        <div class="card"><div class="card-body">
            <div class="skeleton title"></div>
            @for (var i = 0; i < 4; i++)
            {
                <div class="skeleton row"></div>
            }
        </div></div>
    </div>
}
else if (_error is not null)
{
    <div class="card">
        <EmptyState Icon="alert" Title="@Session.T("Could not load the dashboard", "تعذّر تحميل لوحة التحكم")"
                    Message="@_error">
            <ActionContent>
                <button type="button" class="btn btn-primary" @onclick="LoadAsync">
                    <ClinicIcon Name="refresh" Class="sm" />
                    <span>@Session.T("Try again", "إعادة المحاولة")</span>
                </button>
            </ActionContent>
        </EmptyState>
    </div>
}
else if (_summary is not null)
{
    <div class="card mb-3" style="overflow:hidden">
        <div class="card-body" style="display:flex;align-items:center;gap:24px;flex-wrap:wrap;
                    background:linear-gradient(120deg, var(--brand-soft), transparent)">
            <div>
                <div class="fs-sm text-muted">@TodayLong</div>
                <h1 style="margin-top:4px">@Greeting, @DisplayName 👋</h1>
                <p class="text-muted mt-1">@Session.T("Here is what is happening in your clinic today.", "إليك ما يحدث في عيادتك اليوم.")</p>
            </div>
            <div class="spacer" style="flex:1"></div>
            <div class="flex gap-2 flex-wrap">
                <button type="button" class="btn btn-outline" @onclick='() => Nav.NavigateTo("patients?new=1")'>
                    <ClinicIcon Name="plus" Class="sm" />
                    <span>@Session.T("New patient", "مريض جديد")</span>
                </button>
                <button type="button" class="btn btn-outline" @onclick='() => Nav.NavigateTo("reports")'>
                    <ClinicIcon Name="chart" Class="sm" />
                    <span>@Session.T("Reports", "التقارير")</span>
                </button>
                <button type="button" class="btn btn-primary" @onclick='() => Nav.NavigateTo("appointments?new=1")'>
                    <ClinicIcon Name="plus" Class="sm" />
                    <span>@Session.T("New appointment", "موعد جديد")</span>
                </button>
            </div>
        </div>
    </div>

    <div class="stat-grid">
        <div class="stat teal">
            <div class="stat-icon"><ClinicIcon Name="users" /></div>
            <div class="stat-value">@_summary.TotalPatients</div>
            <div class="stat-label">@Session.T("Total patients", "إجمالي المرضى")</div>
            <div class="stat-trend down"><ClinicIcon Name="alert" Class="sm" /> @_summary.PatientsWithMedicalAlerts @Session.T("with medical alerts", "بتنبيهات طبية")</div>
        </div>
        <div class="stat blue">
            <div class="stat-icon"><ClinicIcon Name="calendar" /></div>
            <div class="stat-value">@_summary.TodayAppointmentCount</div>
            <div class="stat-label">@Session.T("Appointments today", "مواعيد اليوم")</div>
            <div class="stat-trend up"><ClinicIcon Name="activity" Class="sm" /> @_summary.TodayScheduledCount @Session.T("scheduled", "محجوز")</div>
        </div>
        <div class="stat green">
            <div class="stat-icon"><ClinicIcon Name="wallet" /></div>
            <div class="stat-value">@Money(_summary.CashCollected)</div>
            <div class="stat-label">@Session.T("Collected revenue", "الإيرادات المحصّلة")</div>
            <div class="stat-trend up"><ClinicIcon Name="chart" Class="sm" /> @WindowLabel</div>
        </div>
        <div class="stat amber">
            <div class="stat-icon"><ClinicIcon Name="invoice" /></div>
            <div class="stat-value">@Money(_summary.Outstanding.TotalOutstanding)</div>
            <div class="stat-label">@Session.T("Outstanding balance", "الأرصدة المستحقة")</div>
            <div class="stat-trend @(_summary.Outstanding.TotalOutstanding > 0 ? "down" : "up")"><ClinicIcon Name="alert" Class="sm" /> @_summary.Outstanding.OpenInvoiceCount @Session.T("open invoices", "فواتير مفتوحة")</div>
        </div>
    </div>

    <div class="grid grid-2-1">
        <div class="card">
            <div class="card-header">
                <div>
                    <div class="card-title">@Session.T("Upcoming appointments", "المواعيد القادمة")</div>
                    <div class="card-subtitle">@Session.T("Next scheduled visits", "الزيارات المجدولة التالية")</div>
                </div>
                <div class="spacer"></div>
                <button type="button" class="btn btn-ghost btn-sm" @onclick='() => Nav.NavigateTo("appointments")'>
                    @Session.T("View all", "عرض الكل") <ClinicIcon Name="chevron-right" Class="sm" />
                </button>
            </div>
            <div class="card-body">
                @if (_summary.UpcomingAppointments.Count == 0)
                {
                    <EmptyState Icon="calendar" Title="@Session.T("No upcoming appointments", "لا توجد مواعيد قادمة")"
                                Message="@Session.T("Schedule a visit to see it here.", "احجز موعداً ليظهر هنا.")" />
                }
                else
                {
                    @foreach (var appt in _summary.UpcomingAppointments)
                    {
                        <div class="list-row">
                            <Avatar Name="@PatientName(appt.PatientName)" />
                            <div class="list-body">
                                <div class="list-title">@PatientName(appt.PatientName)</div>
                                <div class="list-sub">
                                    @ClinicFormatting.DateTimeLabel(appt.ScheduledDateTime) ·
                                    @ServiceName(appt.ServiceName) · @DoctorName(appt.DoctorName)
                                </div>
                            </div>
                            <AppointmentStatusBadge Value="appt.Status" />
                        </div>
                    }
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <div>
                    <div class="card-title">@Session.T("Appointment mix", "توزيع المواعيد")</div>
                    <div class="card-subtitle">@WindowLabel</div>
                </div>
            </div>
            <div class="card-body">
                @foreach (var item in StatusBreakdown())
                {
                    <div class="mb-3">
                        <div class="flex-between mb-1">
                            <span class="fs-sm fw-600">@item.Label</span>
                            <span class="fs-sm text-muted mono">@item.Count</span>
                        </div>
                        <div style="height:8px;border-radius:999px;background:var(--surface-3);overflow:hidden">
                            <div style="height:100%;width:@item.Percent%;border-radius:999px;background:@item.Color"></div>
                        </div>
                    </div>
                }

                <div class="divider"></div>

                <div class="flex-between mb-2">
                    <span class="text-muted fs-sm">@Session.T("Total appointments", "إجمالي المواعيد")</span>
                    <span class="fw-700 mono">@_summary.AppointmentStatusBreakdown.Sum(row => row.Count)</span>
                </div>
                <div class="flex-between mb-2">
                    <span class="text-muted fs-sm">@Session.T("Active doctors", "الأطباء النشطون")</span>
                    <span class="fw-700 mono">@_summary.TotalDoctors</span>
                </div>
                <div class="flex-between mb-2">
                    <span class="text-muted fs-sm">@Session.T("Services offered", "الخدمات المتاحة")</span>
                    <span class="fw-700 mono">@_summary.TotalServices</span>
                </div>
                <div class="flex-between">
                    <span class="text-muted fs-sm">@Session.T("Billed in this window", "المفوتر في هذه الفترة")</span>
                    <span class="fw-700 mono">@Money(_summary.Revenue.TotalBilled)</span>
                </div>
            </div>
        </div>
    </div>

    <div class="grid grid-2-1 mt-3">
        <div class="card">
            <div class="card-header">
                <div class="card-title">@Session.T("Recent invoices", "أحدث الفواتير")</div>
                <div class="spacer"></div>
                <button type="button" class="btn btn-ghost btn-sm" @onclick='() => Nav.NavigateTo("invoices")'>
                    @Session.T("Billing", "الفوترة") <ClinicIcon Name="chevron-right" Class="sm" />
                </button>
            </div>
            @if (_summary.RecentInvoices.Count == 0)
            {
                <EmptyState Icon="invoice" Title="@Session.T("No invoices yet", "لا توجد فواتير بعد")" />
            }
            else
            {
                <div class="table-wrap">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>@Session.T("Patient", "المريض")</th>
                                <th>@Session.T("Total", "الإجمالي")</th>
                                <th>@Session.T("Balance", "المتبقي")</th>
                                <th>@Session.T("Status", "الحالة")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var invoice in _summary.RecentInvoices)
                            {
                                <tr>
                                    <td>
                                        <div class="cell-person">
                                            <Avatar Name="@PatientName(invoice.PatientName)" Size="sm" />
                                            <span class="cell-main">@PatientName(invoice.PatientName)</span>
                                        </div>
                                    </td>
                                    <td class="mono">@Money(invoice.TotalAmount)</td>
                                    <td class="mono fw-600">@Money(invoice.RemainingAmount)</td>
                                    <td><PaymentStatusBadge Value="invoice.Status" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <div class="card">
            <div class="card-header">
                <div class="card-title">@Session.T("Newest patients", "أحدث المرضى")</div>
            </div>
            <div class="card-body">
                @if (_summary.NewestPatients.Count == 0)
                {
                    <EmptyState Icon="users" Title="@Session.T("No patients yet", "لا يوجد مرضى بعد")" />
                }
                else
                {
                    @foreach (var patient in _summary.NewestPatients)
                    {
                        <div class="list-row" style="cursor:pointer" @onclick='() => Nav.NavigateTo($"patients/{patient.Id}")'>
                            <Avatar Name="@patient.FullName" />
                            <div class="list-body">
                                <div class="list-title">@patient.FullName</div>
                                <div class="list-sub">@ClinicFormatting.Age(patient.DateOfBirth) @Session.T("yrs", "سنة") · @patient.PrimaryPhone</div>
                            </div>
                            <ClinicIcon Name="chevron-right" Class="sm text-soft" />
                        </div>
                    }
                }
            </div>
        </div>
    </div>
}

@code {
    private string Money(decimal amount) => ClinicFormatting.Money(amount, Branding.BaseCurrency);

    private bool _loading = true;
    private string? _error;
    private DashboardSummaryDto? _summary;

    private string DisplayName => string.IsNullOrWhiteSpace(Session.UserName) ? "there" : Session.UserName;

    private string Greeting => IsRtl ? "مرحباً" : "Good " + PartOfDay;

    private string PartOfDay => DateTime.Now.Hour switch
    {
        < 12 => "morning",
        < 17 => "afternoon",
        _ => "evening",
    };

    private bool IsRtl => Session.IsRtl;

    private string TodayLong => DateTime.Today.ToString("dddd, dd MMMM yyyy", System.Globalization.CultureInfo.InvariantCulture);

    /// <summary>The reporting window the server used, so no figure here is undated.</summary>
    private string WindowLabel => _summary is null
        ? string.Empty
        : ClinicFormatting.ShortDate(_summary.From) + " – " + ClinicFormatting.ShortDate(_summary.To);

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        StateHasChanged();

        try
        {
            // One server-computed payload: every figure below is a SQL aggregate
            // over the whole dataset, never a sum over a page of results.
            _summary = await Api.GetDashboardSummaryAsync();
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        catch (Exception)
        {
            _error = Session.T("Unable to reach the clinic server.", "تعذّر الاتصال بالخادم.");
        }
        finally
        {
            _loading = false;
        }
    }

    private string PatientName(string name) =>
        string.IsNullOrWhiteSpace(name) ? Session.T("Unknown patient", "مريض غير معروف") : name;

    private string DoctorName(string name) =>
        string.IsNullOrWhiteSpace(name) ? Session.T("Unassigned", "غير مُعيّن") : name;

    private string ServiceName(string? name) =>
        string.IsNullOrWhiteSpace(name) ? Session.T("No service", "بدون خدمة") : name;

    private IEnumerable<(string Label, int Count, double Percent, string Color)> StatusBreakdown()
    {
        var rows = _summary?.AppointmentStatusBreakdown ?? [];
        var total = Math.Max(rows.Sum(row => row.Count), 1);

        return rows.Select(row => (
            Label: ClinicFormatting.StatusLabel(row.Status, IsRtl),
            Count: row.Count,
            Percent: row.Count * 100.0 / total,
            Color: StatusColor(row.Status)));
    }

    private static string StatusColor(AppointmentStatus status) => status switch
    {
        AppointmentStatus.Scheduled => "var(--info)",
        AppointmentStatus.Completed => "var(--success)",
        AppointmentStatus.Cancelled => "var(--text-soft)",
        _ => "var(--warning)",
    };
}