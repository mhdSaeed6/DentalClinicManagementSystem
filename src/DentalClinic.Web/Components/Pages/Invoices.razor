@page "/invoices"
@inject ApiClient Api
@inject ClinicSessionState Session
@inject NotificationService Notifier
@inject NavigationManager Nav

<PageTitle>@Session.T("Billing", "الفوترة") · @Session.T("Al Noor Dental", "عيادة النور")</PageTitle>

<PageHeader Title="@Session.T("Billing & invoices", "الفوترة والفواتير")"
            Subtitle="@Session.T("Track charges, payments and outstanding balances.", "تابع الرسوم والمدفوعات والأرصدة المستحقة.")">
    <Actions>
        <button type="button" class="btn btn-outline" @onclick="LoadAsync" disabled="@_loading">
            <ClinicIcon Name="refresh" Class="sm" /><span>@Session.T("Refresh", "تحديث")</span>
        </button>
        @if (!Session.IsDoctor)
        {
            <button type="button" class="btn btn-primary" @onclick="OpenCreate">
                <ClinicIcon Name="plus" Class="sm" /><span>@Session.T("New invoice", "فاتورة جديدة")</span>
            </button>
        }
    </Actions>
</PageHeader>

<div class="stat-grid">
    <div class="stat teal">
        <div class="stat-icon"><ClinicIcon Name="invoice" /></div>
        <div class="stat-value">@_invoices.Count</div>
        <div class="stat-label">@Session.T("Invoices loaded", "الفواتير المحمّلة")</div>
    </div>
    <div class="stat green">
        <div class="stat-icon"><ClinicIcon Name="wallet" /></div>
        <div class="stat-value">@ClinicFormatting.Money(_invoices.Sum(i => i.PaidAmount))</div>
        <div class="stat-label">@Session.T("Collected", "المحصّل")</div>
    </div>
    <div class="stat amber">
        <div class="stat-icon"><ClinicIcon Name="alert" /></div>
        <div class="stat-value">@ClinicFormatting.Money(_invoices.Sum(i => i.RemainingAmount))</div>
        <div class="stat-label">@Session.T("Outstanding", "المستحق")</div>
    </div>
    <div class="stat rose">
        <div class="stat-icon"><ClinicIcon Name="clock" /></div>
        <div class="stat-value">@_invoices.Count(i => i.Status != PaymentStatus.Paid)</div>
        <div class="stat-label">@Session.T("Open invoices", "فواتير مفتوحة")</div>
    </div>
</div>

<div class="card">
    <div class="card-header" style="flex-wrap:wrap;gap:12px">
        <div class="flex gap-1 flex-wrap">
            <button type="button" class="chip @(_statusFilter is null ? "active" : "")" @onclick='() => _statusFilter = null'>@Session.T("All", "الكل")</button>
            <button type="button" class="chip @(_statusFilter == PaymentStatus.Unpaid ? "active" : "")" @onclick='() => _statusFilter = PaymentStatus.Unpaid'>@Session.T("Unpaid", "غير مدفوعة")</button>
            <button type="button" class="chip @(_statusFilter == PaymentStatus.PartiallyPaid ? "active" : "")" @onclick='() => _statusFilter = PaymentStatus.PartiallyPaid'>@Session.T("Partial", "جزئية")</button>
            <button type="button" class="chip @(_statusFilter == PaymentStatus.Paid ? "active" : "")" @onclick='() => _statusFilter = PaymentStatus.Paid'>@Session.T("Paid", "مدفوعة")</button>
        </div>
        <div class="spacer" style="flex:1"></div>
        <select class="select" style="max-width:220px" @bind="_patientFilter" @bind:after="ApplyFilter">
            <option value="">@Session.T("All patients", "كل المرضى")</option>
            @foreach (var patient in _patients)
            {
                <option value="@patient.Id">@FullName(patient.FirstName, patient.LastName)</option>
            }
        </select>
    </div>

    @if (_loading)
    {
        <div class="card-body">
            @for (var i = 0; i < 5; i++)
            {
                <div class="skeleton row"></div>
            }
        </div>
    }
    else if (Filtered.Count == 0)
    {
        <EmptyState Icon="invoice" Title="@Session.T("No invoices", "لا توجد فواتير")"
                    Message="@Session.T("Create an invoice to start tracking payments.", "أنشئ فاتورة لبدء تتبع المدفوعات.")">
            <ActionContent>
                @if (!Session.IsDoctor)
                {
                    <button type="button" class="btn btn-primary" @onclick="OpenCreate"><ClinicIcon Name="plus" Class="sm" /> @Session.T("New invoice", "فاتورة جديدة")</button>
                }
            </ActionContent>
        </EmptyState>
    }
    else
    {
        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th>@Session.T("Invoice", "الفاتورة")</th>
                        <th>@Session.T("Patient", "المريض")</th>
                        <th>@Session.T("Total", "الإجمالي")</th>
                        <th>@Session.T("Paid", "المدفوع")</th>
                        <th>@Session.T("Balance", "المتبقي")</th>
                        <th>@Session.T("Status", "الحالة")</th>
                        <th style="text-align:end">@Session.T("Actions", "إجراءات")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var invoice in Filtered)
                    {
                        <tr>
                            <td class="cell-main mono">#@invoice.Id.ToString()[..8]</td>
                            <td>
                                <div class="cell-person">
                                    <Avatar Name="@PatientName(invoice)" Size="sm" />
                                    <span class="cell-main">@PatientName(invoice)</span>
                                </div>
                            </td>
                            <td class="mono">@ClinicFormatting.Money(invoice.TotalAmount)</td>
                            <td class="mono text-success">@ClinicFormatting.Money(invoice.PaidAmount)</td>
                            <td class="mono fw-700">@ClinicFormatting.Money(invoice.RemainingAmount)</td>
                            <td><PaymentStatusBadge Value="invoice.Status" /></td>
                            <td>
                                <div class="row-actions">
                                    <button type="button" class="btn btn-outline btn-sm" @onclick="() => OpenDetails(invoice)">
                                        <ClinicIcon Name="eye" Class="sm" /> @Session.T("Manage", "إدارة")
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <Pager PageNumber="_page" PageSize="_pageSize" TotalCount="_total" TotalPages="_totalPages" OnPageChange="GoToPage" />
    }
</div>

<Modal IsOpen="_formOpen" Title="@Session.T("New invoice", "فاتورة جديدة")"
       Subtitle="@Session.T("Charge a patient for treatment", "تحصيل مبلغ من المريض مقابل العلاج")" OnClose="CloseForm">
    <ChildContent>
    @if (!string.IsNullOrWhiteSpace(_formError))
    {
        <div class="badge danger no-dot mb-2" style="display:flex;padding:10px 14px;border-radius:11px">
            <ClinicIcon Name="alert" Class="sm" /><span>@_formError</span>
        </div>
    }
    <div class="field">
        <label class="label">@Session.T("Patient", "المريض") <span class="req">*</span></label>
        <select class="select" @bind="_form.PatientId" @bind:after="OnFormPatientChangedAsync">
            <option value="@Guid.Empty">@Session.T("— Select patient —", "— اختر المريض —")</option>
            @foreach (var patient in _patients)
            {
                <option value="@patient.Id">@FullName(patient.FirstName, patient.LastName) · @patient.PrimaryPhone</option>
            }
        </select>
    </div>

    @* Optional appointment linkage. Only this patient's eligible appointments are
       offered, and the total is derived from the appointment's charges on the
       server rather than trusted from this form. *@
    <div class="field">
        <label class="label">@Session.T("Link to an appointment (optional)", "ربط بموعد (اختياري)")</label>
        <select class="select" @bind="_form.AppointmentId" @bind:after="OnFormAppointmentChangedAsync" disabled="@(_formAppointments.Count == 0)">
            <option value="">@Session.T("— Standalone invoice —", "— فاتورة مستقلة —")</option>
            @foreach (var appointment in _formAppointments)
            {
                <option value="@appointment.Id">
                    @ClinicFormatting.DateTimeLabel(appointment.ScheduledDateTime) · @ServiceNameOrNone(appointment.ServiceId)
                </option>
            }
        </select>
    </div>

    @if (_formBreakdown is { HasBillableItems: true })
    {
        <div class="card mb-2">
            <div class="card-body" style="padding:12px">
                <div class="fs-xs text-soft">@Session.T("Charges for this appointment", "رسوم هذا الموعد")</div>
                @if (_formBreakdown.ServiceSubtotal > 0)
                {
                    <div class="flex-between fs-sm">
                        <span>@(_formBreakdown.ServiceName ?? Session.T("Service", "الخدمة"))</span>
                        <span class="mono">@ClinicFormatting.Money(_formBreakdown.ServiceSubtotal)</span>
                    </div>
                }
                <div class="flex-between fs-sm">
                    <span>@Session.T("Treatments", "العلاجات") (@_formBreakdown.TreatmentCount)</span>
                    <span class="mono">@ClinicFormatting.Money(_formBreakdown.TreatmentSubtotal)</span>
                </div>
                <div class="flex-between fw-700" style="border-top:1px solid var(--border);padding-top:6px;margin-top:6px">
                    <span>@Session.T("Server-calculated total", "الإجمالي المحسوب")</span>
                    <span class="mono">@ClinicFormatting.Money(_formBreakdown.EstimatedTotal)</span>
                </div>
            </div>
        </div>
    }

    <div class="field">
        <label class="label">@Session.T("Total amount (USD)", "المبلغ الإجمالي (دولار)") <span class="req">*</span></label>
        <input type="number" step="0.01" min="0.01" class="input" @bind="_form.TotalAmount" disabled="@(_form.AppointmentId is not null)" />
    </div>
    @if (_form.AppointmentId is not null)
    {
        <p class="text-muted fs-sm">
            @Session.T(
                "This invoice is derived from the appointment, so the amount is calculated on the server.",
                "تُشتق هذه الفاتورة من الموعد، لذلك يُحتسب المبلغ على الخادم.")
        </p>
    }
    else
    {
        <p class="text-muted fs-sm">@Session.T("Leave the appointment empty to create a standalone invoice.", "اترك الموعد فارغاً لإنشاء فاتورة مستقلة.")</p>
    }
    </ChildContent>

    <Footer>
        <button type="button" class="btn btn-ghost" @onclick="CloseForm">@Session.T("Cancel", "إلغاء")</button>
        <button type="button" class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">
            @if (_saving)
            {
                <span class="spinner"></span>
            }
            else
            {
                <ClinicIcon Name="check" Class="sm" />
            }
            <span>@Session.T("Create invoice", "إنشاء الفاتورة")</span>
        </button>
    </Footer>
</Modal>

<Drawer IsOpen="_drawerOpen" Title="@($"#{_selected?.Id.ToString()[..8]}")"
        Subtitle="@(_selected is null ? null : PatientName(_selected))" Icon="invoice"
        OnClose="() => _drawerOpen = false">
    @if (_selected is not null)
    {
        <div class="grid" style="grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:20px">
            <div class="card"><div class="card-body" style="padding:14px">
                <div class="fs-xs text-soft">@Session.T("Total", "الإجمالي")</div>
                <div class="fw-700 mono">@ClinicFormatting.Money(_selected.TotalAmount)</div>
            </div></div>
            <div class="card"><div class="card-body" style="padding:14px">
                <div class="fs-xs text-soft">@Session.T("Paid", "المدفوع")</div>
                <div class="fw-700 mono text-success">@ClinicFormatting.Money(_selected.PaidAmount)</div>
            </div></div>
            <div class="card"><div class="card-body" style="padding:14px">
                <div class="fs-xs text-soft">@Session.T("Balance", "المتبقي")</div>
                <div class="fw-700 mono">@ClinicFormatting.Money(_selected.RemainingAmount)</div>
            </div></div>
        </div>

        <div class="flex-between mb-2">
            <h3>@Session.T("Payment history", "سجل المدفوعات")</h3>
            <PaymentStatusBadge Value="_selected.Status" />
        </div>

        @if (_selected.Payments.Count == 0)
        {
            <p class="text-muted fs-sm mb-3">@Session.T("No payments recorded yet.", "لم تُسجَّل أي مدفوعات بعد.")</p>
        }
        else
        {
            <div class="mb-3">
                @foreach (var payment in _selected.Payments.OrderByDescending(p => p.PaidAtUtc))
                {
                    <div class="list-row">
                        <div class="stat-icon green" style="margin:0;width:38px;height:38px"><ClinicIcon Name="check" Class="sm" /></div>
                        <div class="list-body">
                            <div class="list-title">@ClinicFormatting.Money(payment.Amount)</div>
                            <div class="list-sub">@ClinicFormatting.DateTimeLabel(payment.PaidAtUtc) @(string.IsNullOrWhiteSpace(payment.TransactionNotes) ? "" : "· " + payment.TransactionNotes)</div>
                        </div>
                    </div>
                }
            </div>
        }

        <div class="flex-between mb-2" style="margin-top:18px">
            <h3 style="margin:0">@Session.T("Invoice lines", "بنود الفاتورة")</h3>
            <LifecycleStatusBadge Value="_selected.LifecycleStatus" />
        </div>

        @if (_selected.Lines.Count == 0)
        {
            <p class="text-muted fs-sm mb-3">@Session.T("No itemised lines on this invoice.", "لا توجد بنود مفصّلة لهذه الفاتورة.")</p>
        }
        else
        {
            <div class="mb-3">
                @foreach (var line in _selected.Lines)
                {
                    <div class="list-row">
                        <div class="list-body">
                            <div class="list-title">@line.Description</div>
                            <div class="list-sub mono">@ClinicFormatting.Money(line.Amount)</div>
                        </div>
                    </div>
                }
            </div>
        }

        @if (_selected.LifecycleStatus == InvoiceLifecycleStatus.Draft && !Session.IsDoctor)
        {
            <div class="divider"></div>
            @if (!string.IsNullOrWhiteSpace(_draftError))
            {
                <div class="badge danger no-dot mb-2" style="display:flex;padding:10px 14px;border-radius:11px">
                    <ClinicIcon Name="alert" Class="sm" /><span>@_draftError</span>
                </div>
            }
            <div class="flex" style="gap:8px">
                <button type="button" class="btn btn-outline btn-block" @onclick="RefreshDraftAsync" disabled="@_saving">
                    <ClinicIcon Name="refresh" Class="sm" />
                    <span>@Session.T("Refresh from appointment", "تحديث من الموعد")</span>
                </button>
                <button type="button" class="btn btn-primary btn-block" @onclick="IssueAsync" disabled="@_saving">
                    @if (_saving)
                    {
                        <span class="spinner"></span>
                    }
                    else
                    {
                        <ClinicIcon Name="check" Class="sm" />
                    }
                    <span>@Session.T("Issue invoice", "إصدار الفاتورة")</span>
                </button>
            </div>
            <p class="text-muted fs-xs mt-2">@Session.T("A draft cannot accept payments until it is issued.", "لا يمكن استلام دفعات على مسودة قبل إصدارها.")</p>
        }

        <ConfirmDialog IsOpen="_confirmRefreshOpen"
                       Title="@Session.T("Discard manual adjustments?", "استبدال التعديلات اليدوية؟")"
                       Message="@Session.T("This draft has manual adjustments.", "تحتوي هذه المسودة على تعديلات يدوية.")"
                       Detail="@Session.T("Recalculating from the appointment will replace them.", "ستُستبدل عند إعادة الحساب من الموعد.")"
                       ConfirmLabel="@Session.T("Discard and refresh", "استبدال وتحديث")"
                       CancelLabel="@Session.T("Keep my changes", "إبقاء تعديلاتي")"
                       OnConfirm="ConfirmRefreshAsync"
                       OnCancel="() => _confirmRefreshOpen = false" />

        @if (_selected.LifecycleStatus == InvoiceLifecycleStatus.Draft)
        {
            @* Payments are never offered for a draft; the backend rejects them too. *@
        }
        else if (_selected.Status != PaymentStatus.Paid && !Session.IsDoctor)
        {
            <div class="divider"></div>
            <h3 class="mb-2">@Session.T("Record a payment", "تسجيل دفعة")</h3>
            @if (!string.IsNullOrWhiteSpace(_paymentError))
            {
                <div class="badge danger no-dot mb-2" style="display:flex;padding:10px 14px;border-radius:11px">
                    <ClinicIcon Name="alert" Class="sm" /><span>@_paymentError</span>
                </div>
            }
            <div class="form-grid">
                <div class="field">
                    <label class="label">@Session.T("Amount (USD)", "المبلغ (دولار)")</label>
                    <input type="number" step="0.01" min="0.01" class="input" @bind="_payment.Amount" />
                </div>
                <div class="field">
                    <label class="label">@Session.T("Notes", "ملاحظات")</label>
                    <input class="input" @bind="_payment.Notes" />
                </div>
            </div>
            <button type="button" class="btn btn-primary btn-block" @onclick="AddPaymentAsync" disabled="@_saving">
                @if (_saving)
                {
                    <span class="spinner"></span>
                }
                else
                {
                    <ClinicIcon Name="plus" Class="sm" />
                }
                <span>@Session.T("Add payment", "إضافة دفعة")</span>
            </button>
        }
    }
</Drawer>

@code {
    private List<InvoiceDto> _invoices = [];
    private List<PatientDto> _patients = [];
    private List<DentalServiceDto> _services = [];
    private int _page = 1;
    private int _pageSize = 10;
    private int _total;
    private int _totalPages;
    private bool _loading = true;
    private bool _saving;

    private PaymentStatus? _statusFilter;
    private Guid? _patientFilter;

    private bool _formOpen;
    private string? _formError;
    private InvoiceFormRequest _form = new();

    private bool _drawerOpen;
    private string? _paymentError;
    private string? _draftError;
    private InvoiceDto? _selected;
    private InvoicePaymentRequest _payment = new();
    private List<AppointmentDto> _formAppointments = [];
    private AppointmentInvoiceBreakdownDto? _formBreakdown;

    private List<InvoiceDto> Filtered => _statusFilter is null
        ? _invoices
        : _invoices.Where(i => i.Status == _statusFilter).ToList();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var patients = await Api.GetPatientsAsync(1, 100, null);
            _patients = patients.Items ?? [];

            // Service names are needed to label the appointment selector.
            try
            {
                var services = await Api.GetServicesAsync(1, 100, null);
                _services = services.Items ?? [];
            }
            catch
            {
                // lookup best-effort
            }
        }
        catch
        {
            // lookup best-effort
        }

        await LoadAsync();

        // Deep link from an appointment ("Open invoice"): open that invoice's drawer.
        var query = NavQuery.Parse(Nav.Uri);
        if (query.TryGetValue("invoice", out var invoiceId) && Guid.TryParse(invoiceId, out var parsedInvoiceId))
        {
            try
            {
                var invoice = await Api.GetInvoiceAsync(parsedInvoiceId);
                OpenDetails(invoice);
            }
            catch
            {
                // The invoice may be inaccessible or gone; the list is still shown.
            }
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            var result = await Api.GetInvoicesAsync(_page, _pageSize, _patientFilter);
            _invoices = result.Items ?? [];
            _total = result.TotalCount;
            _totalPages = result.TotalPages;
        }
        catch (ApiException ex)
        {
            Notifier.Error(Session.T("Could not load invoices", "تعذّر تحميل الفواتير"), ex.Message);
            _invoices = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ApplyFilter()
    {
        _page = 1;
        await LoadAsync();
    }

    private async Task GoToPage(int page)
    {
        _page = page;
        await LoadAsync();
    }

    private void OpenCreate()
    {
        _form = new InvoiceFormRequest { TotalAmount = 50 };
        _formError = null;
        _formAppointments = [];
        _formBreakdown = null;
        _formOpen = true;
    }

    /// <summary>
    /// Loads only this patient's eligible appointments, so the selector cannot
    /// offer a visit belonging to somebody else.
    /// </summary>
    private async Task OnFormPatientChangedAsync()
    {
        _form.AppointmentId = null;
        _formBreakdown = null;
        _formAppointments = [];

        if (_form.PatientId == Guid.Empty)
        {
            return;
        }

        try
        {
            var result = await Api.GetAppointmentsAsync(1, 50, _form.PatientId);
            _formAppointments = (result.Items ?? [])
                .Where(a => a.Status == AppointmentStatus.Completed || a.Status == AppointmentStatus.Scheduled)
                .ToList();
        }
        catch (ApiException ex)
        {
            _formError = ex.Message;
        }
    }

    private async Task OnFormAppointmentChangedAsync()
    {
        _formBreakdown = null;

        if (_form.AppointmentId is not { } appointmentId)
        {
            return;
        }

        try
        {
            _formBreakdown = await Api.GetAppointmentInvoiceBreakdownAsync(appointmentId);

            if (_formBreakdown.HasBillableItems)
            {
                // Show the authoritative figure; the server recalculates anyway.
                _form.TotalAmount = _formBreakdown.EstimatedTotal;
            }
            else
            {
                _formError = Session.T(
                    "This appointment has nothing billable, so it cannot be invoiced.",
                    "لا يوجد في هذا الموعد عناصر قابلة للفوترة.");
            }
        }
        catch (ApiException ex)
        {
            _formError = ex.Message;
        }
    }

    private string ServiceNameOrNone(Guid? serviceId)
    {
        if (serviceId is null || serviceId == Guid.Empty)
        {
            return Session.T("No service", "بدون خدمة");
        }

        var service = _services.FirstOrDefault(s => s.Id == serviceId);
        return service?.Name ?? Session.T("No service", "بدون خدمة");
    }

    private void CloseForm()
    {
        _formOpen = false;
        _formError = null;
        _formAppointments = [];
        _formBreakdown = null;
    }

    private async Task SaveAsync()
    {
        _formError = null;
        if (_form.PatientId == Guid.Empty)
        {
            _formError = Session.T("Please select a patient.", "الرجاء اختيار المريض.");
            return;
        }

        if (_form.AppointmentId is not null)
        {
            // The server derives the total and revalidates the patient/appointment
            // pairing, so the form's amount is only a display value here.
            _formError = null;
        }
        else if (_form.TotalAmount <= 0)
        {
            _formError = Session.T("Total amount must be greater than zero.", "يجب أن يكون المبلغ أكبر من صفر.");
            return;
        }

        _saving = true;
        try
        {
            var invoice = await Api.CreateInvoiceAsync(_form);
            Notifier.Success(Session.T("Invoice created", "تم إنشاء الفاتورة"));
            CloseForm();
            OpenDetails(invoice, reload: true);
        }
        catch (ApiException ex)
        {
            _formError = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    /// <summary>
    /// Issues the draft. The server treats an already-issued invoice as a
    /// no-op, so this is safe to press twice.
    /// </summary>
    private async Task IssueAsync()
    {
        if (_selected is null)
        {
            return;
        }

        _draftError = null;
        _saving = true;
        try
        {
            var updated = await Api.IssueInvoiceAsync(_selected.Id);
            _selected = updated;
            Notifier.Success(Session.T("Invoice issued", "تم إصدار الفاتورة"));
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            _draftError = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    /// <summary>
    /// Recalculates the draft from its appointment. If the draft carries manual
    /// adjustments the server refuses; the user is asked to confirm first so
    /// their work is never silently discarded.
    /// </summary>
    private async Task RefreshDraftAsync()
    {
        if (_selected is null)
        {
            return;
        }

        _draftError = null;
        _saving = true;
        try
        {
            var updated = await Api.RefreshInvoiceDraftAsync(_selected.Id);
            _selected = updated;
            Notifier.Success(Session.T("Draft refreshed from the appointment", "تم تحديث المسودة من الموعد"));
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            // The server signals that manual adjustments exist. Ask before
            // discarding them rather than retrying automatically.
            if (ex.Message.Contains("ManualAdjustments", StringComparison.OrdinalIgnoreCase))
            {
                _confirmRefreshOpen = true;
                return;
            }

            _draftError = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private bool _confirmRefreshOpen;
    private bool _confirmingRefresh;

    private async Task ConfirmRefreshAsync()
    {
        _confirmingRefresh = true;
        try
        {
            var updated = await Api.RefreshInvoiceDraftAsync(_selected!.Id, confirmDiscardManualAdjustments: true);
            _selected = updated;
            _confirmRefreshOpen = false;
            Notifier.Success(Session.T("Draft refreshed from the appointment", "تم تحديث المسودة من الموعد"));
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            _draftError = ex.Message;
            _confirmRefreshOpen = false;
        }
        finally
        {
            _confirmingRefresh = false;
            _saving = false;
        }
    }

    private void OpenDetails(InvoiceDto invoice, bool reload = false)
    {
        _selected = invoice;
        _payment = new InvoicePaymentRequest();
        _paymentError = null;
        _drawerOpen = true;

        if (reload)
        {
            _ = LoadAsync();
        }
    }

    private async Task AddPaymentAsync()
    {
        if (_selected is null)
        {
            return;
        }

        _paymentError = null;
        if (_payment.Amount <= 0)
        {
            _paymentError = Session.T("Enter an amount greater than zero.", "أدخل مبلغاً أكبر من صفر.");
            return;
        }

        _saving = true;
        try
        {
            _selected = await Api.AddInvoicePaymentAsync(_selected.Id, _payment);
            _payment = new InvoicePaymentRequest();
            Notifier.Success(Session.T("Payment recorded", "تم تسجيل الدفعة"));
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            _paymentError = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private string FullName(string? first, string? last) => ClinicFormatting.FullName(first, last);

    private string PatientName(InvoiceDto invoice)
    {
        if (!string.IsNullOrWhiteSpace(invoice.PatientName))
        {
            return invoice.PatientName;
        }

        return _patients.FirstOrDefault(p => p.Id == invoice.PatientId) is { } patient
            ? FullName(patient.FirstName, patient.LastName)
            : Session.T("Unknown patient", "مريض غير معروف");
    }
}
