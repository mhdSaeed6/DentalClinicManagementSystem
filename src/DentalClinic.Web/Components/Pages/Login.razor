@page "/login"
@layout AuthLayout
@inject ApiClient Api
@inject ClinicSessionState Session
@inject NotificationService Notifier
@inject NavigationManager Nav

<PageTitle>@Session.T("Sign in", "تسجيل الدخول") · @Session.T("Al Noor Dental Clinic", "عيادة النور")</PageTitle>

<div class="auth-shell">
    <aside class="auth-aside">
        <div class="flex-center gap-2">
            <div class="brand-logo"><ClinicIcon Name="tooth" /></div>
            <div class="brand-text">
                <strong style="font-size:1.1rem">@Session.T("Al Noor Dental", "عيادة النور")</strong>
                <span>@Session.T("Clinic Suite", "نظام إدارة العيادة")</span>
            </div>
        </div>

        <h1>@Session.T("Modern care, beautifully managed.", "رعاية حديثة بإدارة أنيقة.")</h1>
        <p>@Session.T(
                "Everything your dental clinic needs — appointments, patient records, treatments and billing — in one calm, connected workspace.",
                "كل ما تحتاجه عيادة الأسنان — المواعيد، سجلات المرضى، العلاجات والفوترة — في مساحة عمل واحدة هادئة ومتكاملة.")</p>

        <div class="auth-features">
            <div class="auth-feature">
                <span class="tick"><ClinicIcon Name="calendar" Class="sm" /></span>
                <span>@Session.T("Smart appointment scheduling", "جدولة ذكية للمواعيد")</span>
            </div>
            <div class="auth-feature">
                <span class="tick"><ClinicIcon Name="tooth" Class="sm" /></span>
                <span>@Session.T("FDI tooth-chart treatment records", "سجلات علاج بمخطط الأسنان FDI")</span>
            </div>
            <div class="auth-feature">
                <span class="tick"><ClinicIcon Name="invoice" Class="sm" /></span>
                <span>@Session.T("Invoices, payments & balances", "الفواتير والمدفوعات والأرصدة")</span>
            </div>
            <div class="auth-feature">
                <span class="tick"><ClinicIcon Name="shield" Class="sm" /></span>
                <span>@Session.T("Role-based, secure access", "وصول آمن حسب الصلاحيات")</span>
            </div>
        </div>
    </aside>

    <main class="auth-main">
        <div class="auth-card">
            <div class="flex-between mb-3">
                <div class="brand-logo" style="margin:0"><ClinicIcon Name="tooth" /></div>
                <div class="flex gap-1">
                    <button type="button" class="icon-btn" @onclick="Session.ToggleLanguage">
                        <ClinicIcon Name="globe" Class="sm" />
                    </button>
                    <button type="button" class="icon-btn" @onclick="Session.ToggleTheme">
                        <ClinicIcon Name="@(Session.ThemeName == "dark" ? "sun" : "moon")" Class="sm" />
                    </button>
                </div>
            </div>

            <h2>@Session.T("Welcome back", "مرحباً بعودتك")</h2>
            <p class="auth-sub">@Session.T("Sign in to manage your clinic.", "سجّل الدخول لإدارة عيادتك.")</p>

            <EditForm Model="_model" OnValidSubmit="SubmitAsync">
                <DataAnnotationsValidator />

                <div class="field">
                    <label class="label">@Session.T("Email", "البريد الإلكتروني")</label>
                    <InputText @bind-Value="_model.Email" class="input" type="email"
                               placeholder="admin@dentalclinic.com" autocomplete="username" />
                    <ValidationMessage For="() => _model.Email" />
                </div>

                <div class="field">
                    <label class="label">@Session.T("Password", "كلمة المرور")</label>
                    <div style="position:relative">
                        <InputText @bind-Value="_model.Password" class="input" type="@(_showPassword ? "text" : "password")"
                                   placeholder="••••••••" autocomplete="current-password"
                                   style="padding-inline-end:44px" />
                        <button type="button" class="icon-btn" style="position:absolute;inset-inline-end:4px;top:3px;border:none;background:transparent"
                                @onclick="() => _showPassword = !_showPassword" tabindex="-1">
                            <ClinicIcon Name="eye" Class="sm" />
                        </button>
                    </div>
                    <ValidationMessage For="() => _model.Password" />
                </div>

                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <div class="badge danger no-dot mb-2" style="display:flex;padding:10px 14px;border-radius:11px">
                        <ClinicIcon Name="alert" Class="sm" />
                        <span>@_error</span>
                    </div>
                }

                <button type="submit" class="btn btn-primary btn-lg btn-block" disabled="@_busy">
                    @if (_busy)
                    {
                        <span class="spinner"></span>
                        <span>@Session.T("Signing in…", "جارٍ تسجيل الدخول…")</span>
                    }
                    else
                    {
                        <ClinicIcon Name="logout" Class="sm" />
                        <span>@Session.T("Sign in", "دخول")</span>
                    }
                </button>
            </EditForm>

            <div class="demo-creds">
                <div class="demo-title">@Session.T("Demo accounts — tap to fill", "حسابات تجريبية — اضغط للتعبئة")</div>
                <button type="button" class="demo-cred" @onclick='() => UseDemo("admin@dentalclinic.com", "Admin!Pass123")'>
                    <ClinicIcon Name="shield" Class="sm" />
                    <span>@Session.T("Administrator", "مدير")</span>
                    <code>admin@dentalclinic.com</code>
                </button>
                <button type="button" class="demo-cred" @onclick='() => UseDemo("dr.smith@dentalclinic.com", "Doctor!Pass123")'>
                    <ClinicIcon Name="doctor" Class="sm" />
                    <span>@Session.T("Doctor", "طبيب")</span>
                    <code>dr.smith@dentalclinic.com</code>
                </button>
                <button type="button" class="demo-cred" @onclick='() => UseDemo("reception@dentalclinic.com", "Receptionist!Pass123")'>
                    <ClinicIcon Name="calendar" Class="sm" />
                    <span>@Session.T("Receptionist", "موظف الاستقبال")</span>
                    <code>reception@dentalclinic.com</code>
                </button>
            </div>
        </div>
    </main>
</div>

@code {
    private LoginModel _model = new();
    private bool _busy;
    private bool _showPassword;
    private string? _error;

    protected override void OnInitialized()
    {
        if (Session.IsAuthenticated)
        {
            Nav.NavigateTo("/");
        }
    }

    private void UseDemo(string email, string password)
    {
        _model = new LoginModel { Email = email, Password = password };
        _error = null;
    }

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;

        try
        {
            var user = await Api.SignInAsync(_model.Email.Trim(), _model.Password);
            var name = user.Roles.Count > 0 ? user.Roles[0] : string.Empty;
            Notifier.Success(
                Session.T("Welcome back!", "مرحباً بعودتك!"),
                Session.T($"Signed in as {name}.", $"تم الدخول بصلاحية {name}."));
            Nav.NavigateTo("/");
        }
        catch (ApiException ex)
        {
            _error = ex.StatusCode is 401 or 403
                ? Session.T("Email or password is incorrect.", "البريد الإلكتروني أو كلمة المرور غير صحيحة.")
                : ex.Message;
        }
        catch (Exception)
        {
            _error = Session.T(
                "Could not reach the clinic server. Please make sure the API is running.",
                "تعذّر الاتصال بالخادم. تأكد من تشغيل الـ API.");
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class LoginModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Email is required.")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string Email { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Password is required.")]
        public string Password { get; set; } = string.Empty;
    }
}
