    /// <summary>
    /// Short extra note next to a stored blood-pressure reading. Local copy of
    /// the parser thresholds in MedicalAlertEvaluator (Web has no Domain ref).
    /// </summary>
    private string BpNote(string reading)
    {
        var parts = reading.Split('/', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (parts.Length == 2
            && int.TryParse(parts[0], out var systolic)
            && int.TryParse(parts[1], out var diastolic))
        {
            if (systolic >= 180 || diastolic >= 120)
            {
                return Session.T("— critically high, consult a doctor first", "— مرتفع بشكل حرج، استشر الطبيب أولاً");
            }

            if (systolic >= 140 || diastolic >= 90)
            {
                return Session.T("— above normal, monitor", "— أعلى من المعدل الطبيعي، يُراقَب");
            }
        }

        return string.Empty;
    }
