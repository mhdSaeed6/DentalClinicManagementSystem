@page "/patients/{Id:guid}"
@inject ApiClient Api
@inject ClinicSessionState Session
@inject ClinicBranding Branding
@inject NavigationManager Nav
@inject NotificationService Notifier

<PageTitle>@(_patient is null ? Session.T("Patient", "مريض") : FullName(_patient)) · @Branding.DisplayName(Session.IsRtl)</PageTitle>

@if (_loading)
{
    <div class="card"><div class="card-body">
        <div class="skeleton title"></div>
        @for (var i = 0; i < 8; i++)
        {
            <div class="skeleton row"></div>
        }
    </div></div>
}
else if (_error is not null)
{
    <div class="card">
        <EmptyState Icon="alert" Title="@Session.T("Patient not found", "لم يتم العثور على المريض")" Message="@_error">
            <ActionContent>
                <button type="button" class="btn btn-primary" @onclick='() => Nav.NavigateTo("patients")'>
                    <ClinicIcon Name="chevron-left" Class="sm" /> @Session.T("Back to patients", "عودة إلى المرضى")
                </button>
            </ActionContent>
        </EmptyState>
    </div>
}
else if (_patient is not null)
{
    <div class="breadcrumb">
        <a href="patients">@Session.T("Patients", "المرضى")</a>
        <ClinicIcon Name="chevron-right" Class="sm" />
        <span>@FullName(_patient)</span>
    </div>

    <div class="card mb-3">
        <div class="card-body" style="display:flex;gap:22px;align-items:center;flex-wrap:wrap">
            <Avatar Name="@FullName(_patient)" Size="lg" />
            <div>
                <h1>@FullName(_patient)</h1>
                <div class="flex gap-2 flex-wrap mt-1">
                    <span class="badge brand no-dot"><ClinicIcon Name="user" Class="sm" /> @ClinicFormatting.GenderLabel(_patient.Gender, Session.IsRtl)</span>
                    <span class="badge muted no-dot"><ClinicIcon Name="calendar" Class="sm" /> @ClinicFormatting.Age(_patient.DateOfBirth) @Session.T("years", "سنة")</span>
                    <span class="badge muted no-dot"><ClinicIcon Name="phone" Class="sm" /> @_patient.PrimaryPhone</span>
                    <WhatsAppButton Phone="@_patient.PrimaryPhone"
                                    HasWhatsAppOnPrimary="_patient.HasWhatsAppOnPrimary"
                                    Message="@GeneralWhatsAppMessage"
                                    Css="btn-success-soft">
                        <ClinicIcon Name="whatsapp" Class="sm" /> WhatsApp
                    </WhatsAppButton>
                </div>
            </div>
            <div class="spacer" style="flex:1"></div>
            <div class="flex gap-2 flex-wrap">
                <button type="button" class="btn btn-outline" @onclick='() => Nav.NavigateTo($"appointments?new=1&patient={_patient.Id}")'>
                    <ClinicIcon Name="calendar" Class="sm" /> @Session.T("Book appointment", "حجز موعد")
                </button>
                <button type="button" class="btn btn-primary" @onclick='() => Nav.NavigateTo($"treatments?new=1&patient={_patient.Id}")'>
                    <ClinicIcon Name="plus" Class="sm" /> @Session.T("Add treatment", "إضافة علاج")
                </button>
            </div>
        </div>
    </div>

    <div class="tabs">
        <button type="button" class="tab @(_tab == "overview" ? "active" : "")" @onclick='() => _tab = "overview"'>@Session.T("Overview", "نظرة عامة")</button>
        <button type="button" class="tab @(_tab == "appointments" ? "active" : "")" @onclick='() => _tab = "appointments"'>@Session.T("Appointments", "المواعيد") (@_appointments.Count)</button>
        <button type="button" class="tab @(_tab == "treatments" ? "active" : "")" @onclick='() => _tab = "treatments"'>@Session.T("Treatments", "العلاجات") (@_treatments.Count)</button>
        <button type="button" class="tab @(_tab == "invoices" ? "active" : "")" @onclick='() => _tab = "invoices"'>@Session.T("Invoices", "الفواتير") (@_invoices.Count)</button>
        <button type="button" class="tab @(_tab == "plans" ? "active" : "")" @onclick='() => _tab = "plans"'>@Session.T("Treatment plans", "خطط العلاج") (@_plans.Count)</button>
        <button type="button" class="tab @(_tab == "odontogram" ? "active" : "")" @onclick='() => _tab = "odontogram"'>@Session.T("Odontogram", "مخطط الأسنان")</button>
        <button type="button" class="tab @(_tab == "images" ? "active" : "")" @onclick="OpenImagesAsync">@Session.T("X-rays & photos", "الأشعة والصور") (@_images.Count)</button>
        @if (Session.IsAdmin)
        {
            <button type="button" class="tab @(_tab == "audit" ? "active" : "")" @onclick='() => _tab = "audit"'>@Session.T("Audit history", "سجل التدقيق")</button>
        }
    </div>

    @if (_tab == "overview")
    {
        <div class="grid grid-1-2">
            <div class="card">
                <div class="card-header"><div class="card-title">@Session.T("Contact details", "بيانات التواصل")</div></div>
                <div class="card-body">
                    <dl class="kv">
                        <dt>@Session.T("Primary phone", "الهاتف الأساسي")</dt>
                        <dd>@_patient.PrimaryPhone</dd>
                        <dt>@Session.T("Secondary phone", "هاتف بديل")</dt>
                        <dd>@(string.IsNullOrWhiteSpace(_patient.SecondaryPhone) ? "—" : _patient.SecondaryPhone)</dd>
                        <dt>@Session.T("Date of birth", "تاريخ الميلاد")</dt>
                        <dd>@ClinicFormatting.LongDate(_patient.DateOfBirth)</dd>
                    </dl>
                </div>
            </div>

            <div>
                <div class="stat-grid" style="grid-template-columns:repeat(3,1fr);margin-bottom:18px">
                    <div class="stat teal">
                        <div class="stat-icon"><ClinicIcon Name="calendar" /></div>
                        <div class="stat-value">@_appointments.Count</div>
                        <div class="stat-label">@Session.T("Visits", "الزيارات")</div>
                    </div>
                    <div class="stat blue">
                        <div class="stat-icon"><ClinicIcon Name="invoice" /></div>
                        <div class="stat-value">@Money(_invoiceSummary?.TotalBilled ?? 0)</div>
                        <div class="stat-label">@Session.T("Total billed (issued)", "إجمالي الفواتير (صادرة)")</div>
                    </div>
                    <div class="stat amber">
                        <div class="stat-icon"><ClinicIcon Name="wallet" /></div>
                        <div class="stat-value">@Money(_invoiceSummary?.TotalOutstanding ?? 0)</div>
                        <div class="stat-label">@Session.T("Balance due (issued)", "الرصيد المستحق (صادرة)")</div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        <div class="card-title">@Session.T("Medical history", "التاريخ الطبي")</div>
                        <div class="spacer"></div>
                        <MedicalAlertBadge Value="@(_patient.MedicalHistory?.AlertSeverity ?? 0)" />
                    </div>
                    <div class="card-body">
                        <div class="flex gap-2 flex-wrap mb-3">
                            <span class="chip @(Med("diabetes") ? "active" : "")"><ClinicIcon Name="droplet" Class="sm" /> @Session.T("Diabetes", "سكري")</span>
                            <span class="chip @(Med("bp") ? "active" : "")"><ClinicIcon Name="activity" Class="sm" /> @Session.T("Hypertension", "ضغط")</span>
                            <span class="chip @(Med("heart") ? "active" : "")"><ClinicIcon Name="heart" Class="sm" /> @Session.T("Heart disease", "أمراض قلب")</span>
                            <span class="chip @(Med("bleeding") ? "active" : "")"><ClinicIcon Name="alert" Class="sm" /> @Session.T("Bleeding disorder", "اضطراب نزيف")</span>
                            <span class="chip @(Med("epilepsy") ? "active" : "")"><ClinicIcon Name="activity" Class="sm" /> @Session.T("Epilepsy", "صرع")</span>
                            <span class="chip @(Med("asthma") ? "active" : "")"><ClinicIcon Name="droplet" Class="sm" /> @Session.T("Asthma", "ربو")</span>
                            <span class="chip @(Med("pregnancy") ? "active" : "")"><ClinicIcon Name="user" Class="sm" /> @Session.T("Pregnancy", "حمل")</span>
                        </div>
                        <dl class="kv">
                            <dt>@Session.T("Allergies", "الحساسية")</dt>
                            <dd>@(string.IsNullOrWhiteSpace(_patient.MedicalHistory?.Allergies) ? Session.T("None recorded", "لا يوجد") : _patient.MedicalHistory!.Allergies)</dd>
                            <dt>@Session.T("Blood pressure", "قراءة الضغط")</dt>
                            <dd>
                                @if (!string.IsNullOrWhiteSpace(_patient.MedicalHistory?.BloodPressureReading))
                                {
                                    <span class="mono">@_patient.MedicalHistory!.BloodPressureReading</span>
                                    @(BpNote(_patient.MedicalHistory.BloodPressureReading))
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </dd>
                            <dt>@Session.T("Pregnancy week", "أسبوع الحمل")</dt>
                            <dd>@(_patient.MedicalHistory?.PregnancyWeeks is { } weeks ? weeks.ToString() : "—")</dd>
                            <dt>@Session.T("Notes", "ملاحظات")</dt>
                            <dd>@(string.IsNullOrWhiteSpace(_patient.MedicalHistory?.Notes) ? "—" : _patient.MedicalHistory!.Notes)</dd>
                        </dl>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (_tab == "appointments")
    {
        <div class="card">
            @if (_appointments.Count == 0)
            {
                <EmptyState Icon="calendar" Title="@Session.T("No appointments", "لا مواعيد")" />
            }
            else
            {
                <div class="table-wrap">
                    <table class="table">
                        <thead><tr>
                            <th>@Session.T("Date", "التاريخ")</th>
                            <th>@Session.T("Doctor", "الطبيب")</th>
                            <th>@Session.T("Service", "الخدمة")</th>
                            <th>@Session.T("Status", "الحالة")</th>
                        </tr></thead>
                        <tbody>
                            @foreach (var appt in _appointments.OrderByDescending(a => a.ScheduledDateTime))
                            {
                                <tr>
                                    <td class="cell-main">@ClinicFormatting.DateTimeLabel(appt.ScheduledDateTime)</td>
                                    <td>@DoctorName(appt.DoctorId)</td>
                                    <td>@ServiceName(appt.ServiceId)</td>
                                    <td><AppointmentStatusBadge Value="appt.Status" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
    else if (_tab == "treatments")
    {
        <div class="card">
            @if (_treatments.Count == 0)
            {
                <EmptyState Icon="tooth" Title="@Session.T("No treatments recorded", "لا علاجات مسجّلة")" />
            }
            else
            {
                <div class="table-wrap">
                    <table class="table">
                        <thead><tr>
                            <th>@Session.T("Tooth", "السن")</th>
                            <th>@Session.T("Procedure", "الإجراء")</th>
                            <th>@Session.T("Doctor", "الطبيب")</th>
                            <th class="text-end">@Session.T("Cost", "التكلفة")</th>
                        </tr></thead>
                        <tbody>
                            @foreach (var treatment in _treatments)
                            {
                                <tr>
                                    <td><span class="badge brand no-dot">@ClinicFormatting.ToothLabel(treatment.ToothNumber)</span></td>
                                    <td class="cell-main">@treatment.ProcedureDetails</td>
                                    <td>@DoctorName(treatment.DoctorId)</td>
                                    <td class="text-end mono fw-600">@Money(treatment.Cost)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
    else if (_tab == "invoices")
    {
        <div class="card">
            @if (_invoices.Count == 0)
            {
                <EmptyState Icon="invoice" Title="@Session.T("No invoices", "لا فواتير")" />
            }
            else
            {
                <div class="table-wrap">
                    <table class="table">
                        <thead><tr>
                            <th>@Session.T("Invoice", "الفاتورة")</th>
                            <th>@Session.T("Total", "الإجمالي")</th>
                            <th>@Session.T("Paid", "المدفوع")</th>
                            <th>@Session.T("Balance", "المتبقي")</th>
                            <th>@Session.T("Status", "الحالة")</th>
                            <th></th>
                        </tr></thead>
                        <tbody>
                            @foreach (var invoice in _invoices)
                            {
                                <tr>
                                    <td class="cell-main mono">@InvoiceFormatting.NumberLabel(invoice)</td>
                                    <td class="mono">@Money(invoice.TotalAmount)</td>
                                    <td class="mono">@Money(invoice.PaidAmount)</td>
                                    <td class="mono fw-600">@Money(invoice.RemainingAmount)</td>
                                    <td><PaymentStatusBadge Value="invoice.Status" /></td>
                                    <td>
                                        @if (InvoiceFormatting.IsPrintable(invoice))
                                        {
                                            <a class="btn btn-ghost btn-sm" href="@($"/invoices/{invoice.Id}/print")">
                                                <ClinicIcon Name="printer" Class="sm" /> @Session.T("Print", "طباعة")
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
    else if (_tab == "plans")
    {
        <div class="card">
            @if (_plans.Count == 0)
            {
                <EmptyState Icon="clipboard" Title="@Session.T("No treatment plans", "لا توجد خطط علاج")"
                            Message="@Session.T("Plans created for this patient will appear here.", "ستظهر هنا خطط العلاج المنشأة لهذا المريض.")" />
            }
            else
            {
                <div class="table-wrap">
                    <table class="table">
                        <thead><tr>
                            <th>@Session.T("Plan", "الخطة")</th>
                            <th>@Session.T("Doctor", "الطبيب")</th>
                            <th>@Session.T("Status", "الحالة")</th>
                            <th>@Session.T("Estimated", "التقديري")</th>
                            <th>@Session.T("Performed", "المنجز")</th>
                            <th></th>
                        </tr></thead>
                        <tbody>
                            @foreach (var plan in _plans)
                            {
                                <tr @key="plan.Id">
                                    <td class="cell-main">@plan.Title</td>
                                    <td>@plan.DoctorName</td>
                                    <td><span class="badge @PlanStatusClass(plan.Status) no-dot">@PlanStatusLabel(plan.Status)</span></td>
                                    <td class="mono">@Money(plan.EstimatedTotal)</td>
                                    <td class="mono text-success">@Money(plan.PerformedTotal)</td>
                                    <td>
                                        <a class="btn btn-outline btn-sm" href="@($"/treatment-plans/{plan.Id}/print")">
                                            @Session.T("Print", "طباعة")
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
    else if (_tab == "odontogram")
    {
        <Odontogram PatientId="Id" />
    }
    else if (_tab == "images")
    {
        <div class="card">
            <div class="card-header">
                <div class="card-title">@Session.T("X-rays & photos", "الأشعة والصور")</div>
                <div class="spacer" style="flex:1"></div>
                @if (CanWrite)
                {
                    <button type="button" class="btn btn-primary btn-sm" @onclick="OpenUpload">
                        <ClinicIcon Name="plus" Class="sm" /> @Session.T("Upload image", "رفع صورة")
                    </button>
                }
            </div>
            <div class="card-body">
                @if (_imagesLoading)
                {
                    <div class="skeleton row"></div>
                    <div class="skeleton row"></div>
                }
                else if (_images.Count == 0)
                {
                    <EmptyState Icon="tooth"
                                Title="@Session.T("No images yet", "لا توجد صور بعد")"
                                Message="@Session.T("Upload X-rays and before/after photos to keep the clinical record complete.", "ارفع الأشعة والصور قبل وبعد العلاج لإكمال السجل السريري.")" />
                }
                else
                {
                    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:16px">
                        @foreach (var image in _images)
                        {
                            <div @key="image.Id" class="card" style="margin:0;overflow:hidden">
                                <div style="aspect-ratio:4/3;background:var(--surface-2);display:flex;align-items:center;justify-content:center">
                                    @if (_imageUrls.TryGetValue(image.Id, out var url))
                                    {
                                        <img src="@url" alt="@image.FileName" style="width:100%;height:100%;object-fit:cover" />
                                    }
                                    else
                                    {
                                        <ClinicIcon Name="tooth" />
                                    }
                                </div>
                                <div class="card-body tight">
                                    <div class="flex gap-2 flex-wrap mb-1">
                                        <span class="badge brand no-dot">@KindLabel(image.Kind)</span>
                                        @if (image.ToothNumber is { } tooth)
                                        {
                                            <span class="badge muted no-dot">@Session.T("Tooth", "السن") @tooth</span>
                                        }
                                    </div>
                                    <div class="fs-sm" style="word-break:break-all">@image.FileName</div>
                                    <div class="fs-xs text-muted">
                                        @ClinicFormatting.LongDate(image.CapturedAtUtc.ToLocalTime().DateTime) · @FormatBytes(image.SizeBytes)
                                    </div>
                                    @if (CanWrite)
                                    {
                                        <div class="row-actions mt-2">
                                            <button type="button" class="btn btn-danger-soft btn-sm"
                                                    @onclick="() => AskDeleteImage(image)">
                                                @Session.T("Delete", "حذف")
                                            </button>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
    else if (_tab == "audit" && Session.IsAdmin)
    {
        <div class="card">
            <div class="card-body">
                <AuditTrailViewer EntityName="Patient" EntityId="Id" />
            </div>
        </div>
    }
}

<Modal IsOpen="_uploadOpen" Title="@Session.T("Upload clinical image", "رفع صورة سريرية")" OnClose="CloseUpload">
    <ChildContent>
        @if (!string.IsNullOrWhiteSpace(_uploadError))
        {
            <div class="badge danger no-dot mb-2">@_uploadError</div>
        }
        <div class="field">
            <label class="label">@Session.T("Image file", "ملف الصورة") <span class="req">*</span></label>
            <InputFile OnChange="OnImageSelected" accept="image/jpeg,image/png,image/webp" />
            <div class="fs-xs text-muted mt-1">
                @Session.T("JPEG, PNG or WebP up to 10 MB.", "JPEG أو PNG أو WebP بحد أقصى 10 ميجابايت.")
            </div>
            @if (_uploadPreviewUrl is not null)
            {
                <div class="mt-2" style="max-height:180px;overflow:hidden;border-radius:8px">
                    <img src="@_uploadPreviewUrl" alt="preview" style="max-width:100%;max-height:180px;object-fit:contain" />
                </div>
            }
        </div>
        <div class="form-grid">
            <div class="field">
                <label class="label">@Session.T("Category", "التصنيف") <span class="req">*</span></label>
                <select class="select" @bind="_uploadKind">
                    <option value="@((int)PatientImageKind.Xray)">@KindLabel(PatientImageKind.Xray)</option>
                    <option value="@((int)PatientImageKind.Before)">@KindLabel(PatientImageKind.Before)</option>
                    <option value="@((int)PatientImageKind.After)">@KindLabel(PatientImageKind.After)</option>
                    <option value="@((int)PatientImageKind.Other)">@KindLabel(PatientImageKind.Other)</option>
                </select>
            </div>
            <div class="field">
                <label class="label">@Session.T("Tooth (optional)", "السن (اختياري)")</label>
                <input type="number" min="11" max="85" class="input" @bind="_uploadToothNumber" />
            </div>
        </div>
        <div class="field">
            <label class="label">@Session.T("Captured on", "تاريخ التصوير")</label>
            <input type="date" class="input"
                   value="@_uploadCapturedAt.ToLocalTime().ToString("yyyy-MM-dd")"
                   @onchange="OnCapturedChanged" />
        </div>
        <div class="field">
            <label class="label">@Session.T("Link to treatment (optional)", "ربط بعلاج (اختياري)")</label>
            <select class="select" @bind="_uploadTreatmentRecordId">
                <option value="@Guid.Empty">@Session.T("- None -", "- بدون -")</option>
                @foreach (var treatment in _treatments)
                {
                    <option value="@treatment.Id">@TreatmentLabel(treatment)</option>
                }
            </select>
        </div>
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-ghost" @onclick="CloseUpload">@Session.T("Cancel", "إلغاء")</button>
        <button type="button" class="btn btn-primary" @onclick="UploadImageAsync" disabled="@(_uploading || _uploadBytes is null)">
            @if (_uploading)
            {
                <span class="spinner"></span>
            }
            @Session.T("Upload", "رفع")
        </button>
    </Footer>
</Modal>

<ConfirmDialog IsOpen="_imageConfirmOpen"
               Title="@Session.T("Delete image", "حذف الصورة")"
               Message="@Session.T($"Delete {_deleteImageName}? The file is removed from storage.", $"حذف {_deleteImageName}؟ سيُحذف الملف من التخزين.")"
               ConfirmLabel="@Session.T("Delete", "حذف")"
               OnConfirm="DeleteImageAsync"
               OnCancel="() => _imageConfirmOpen = false" />

@code {
    private string Money(decimal amount) => ClinicFormatting.Money(amount, Branding.BaseCurrency);

    [Parameter] public Guid Id { get; set; }

    private const long MaxImageBytes = 10 * 1024 * 1024;

    private bool _loading = true;
    private string? _error;
    private string _tab = "overview";
    private PatientDto? _patient;
    private List<DoctorDto> _doctors = [];
    private List<DentalServiceDto> _services = [];
    private List<AppointmentDto> _appointments = [];
    private List<TreatmentRecordDto> _treatments = [];
    private List<TreatmentPlanDto> _plans = [];
    private List<InvoiceDto> _invoices = [];
    private InvoiceSummaryDto? _invoiceSummary;

    private List<PatientImageDto> _images = [];
    private Dictionary<Guid, string> _imageUrls = [];
    private bool _imagesLoading;

    private bool _uploadOpen, _uploading;
    private string? _uploadError;
    private byte[]? _uploadBytes;
    private string? _uploadFileName;
    private string? _uploadContentType;
    private string? _uploadPreviewUrl;
    private int _uploadKind = (int)PatientImageKind.Xray;
    private int? _uploadToothNumber;
    private DateTimeOffset _uploadCapturedAt = DateTimeOffset.UtcNow;
    private Guid _uploadTreatmentRecordId = Guid.Empty;

    private bool _imageConfirmOpen;
    private PatientImageDto? _deleteImage;
    private string _deleteImageName = string.Empty;

    private bool CanWrite => Session.IsAdmin || Session.IsDoctor;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var patientTask = Api.GetPatientAsync(Id);
            var doctorsTask = Api.GetDoctorsAsync(1, 100, null);
            var servicesTask = Api.GetServicesAsync(1, 100, null);
            var appointmentsTask = Api.GetAppointmentsAsync(1, 100, patientId: Id);
            var treatmentsTask = Api.GetTreatmentRecordsAsync(1, 100, patientId: Id);
            var plansTask = Api.GetTreatmentPlansAsync(1, 100, patientId: Id);
            var invoicesTask = Api.GetInvoicesAsync(1, 100, patientId: Id);
            var summaryTask = Api.GetInvoiceSummaryAsync(Id);
            var imagesTask = Api.GetPatientImagesAsync(Id);

            await Task.WhenAll(patientTask, doctorsTask, servicesTask, appointmentsTask, treatmentsTask, plansTask, invoicesTask, summaryTask, imagesTask);

            _patient = await patientTask;
            _doctors = (await doctorsTask).Items ?? [];
            _services = (await servicesTask).Items ?? [];
            _appointments = (await appointmentsTask).Items ?? [];
            _treatments = (await treatmentsTask).Items ?? [];
            _plans = (await plansTask).Items ?? [];
            _invoices = (await invoicesTask).Items ?? [];
            _invoiceSummary = await summaryTask;
            _images = [.. await imagesTask];
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        catch (Exception)
        {
            _error = Session.T("Unable to load this patient.", "تعذّر تحميل بيانات المريض.");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenImagesAsync()
    {
        _tab = "images";

        if (_images.Count == 0 || _imageUrls.Count == _images.Count)
        {
            return;
        }

        await LoadImagePreviewsAsync();
    }

    private async Task LoadImagePreviewsAsync()
    {
        _imagesLoading = true;
        StateHasChanged();

        try
        {
            foreach (var image in _images)
            {
                if (_imageUrls.ContainsKey(image.Id))
                {
                    continue;
                }

                try
                {
                    var file = await Api.GetPatientImageContentAsync(Id, image.Id);
                    _imageUrls[image.Id] = ToDataUrl(file.ContentType, file.Content);
                }
                catch (Exception)
                {
                    // A missing or unreadable binary must never blank the gallery.
                }
            }
        }
        finally
        {
            _imagesLoading = false;
        }
    }

    private void OpenUpload()
    {
        _uploadError = null;
        _uploadBytes = null;
        _uploadFileName = null;
        _uploadContentType = null;
        _uploadPreviewUrl = null;
        _uploadKind = (int)PatientImageKind.Xray;
        _uploadToothNumber = null;
        _uploadCapturedAt = DateTimeOffset.UtcNow;
        _uploadTreatmentRecordId = Guid.Empty;
        _uploadOpen = true;
    }

    private void CloseUpload()
    {
        _uploadOpen = false;
        _uploadError = null;
    }

    private async Task OnImageSelected(InputFileChangeEventArgs args)
    {
        _uploadError = null;
        _uploadBytes = null;
        _uploadPreviewUrl = null;

        var file = args.File;

        if (file.Size <= 0)
        {
            _uploadError = Session.T("The selected file is empty.", "الملف المحدد فارغ.");
            return;
        }

        if (file.Size > MaxImageBytes)
        {
            _uploadError = Session.T("Images must be 10 MB or smaller.", "يجب ألا يتجاوز حجم الصورة 10 ميجابايت.");
            return;
        }

        try
        {
            await using var stream = file.OpenReadStream(MaxImageBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            var content = buffer.ToArray();

            // Sniff locally so the declared type always agrees with what the API
            // will detect from the bytes, and reject non-images before uploading.
            var contentType = DetectContentType(content);

            if (contentType is null)
            {
                _uploadError = Session.T("Only JPEG, PNG or WebP images are accepted.", "تُقبل صور JPEG أو PNG أو WebP فقط.");
                return;
            }

            _uploadBytes = content;
            _uploadFileName = file.Name;
            _uploadContentType = contentType;
            _uploadPreviewUrl = ToDataUrl(contentType, content);
        }
        catch (Exception)
        {
            _uploadError = Session.T("Could not read the selected file.", "تعذّر قراءة الملف المحدد.");
        }
    }

    private async Task UploadImageAsync()
    {
        if (_uploadBytes is null || _uploadFileName is null || _uploadContentType is null)
        {
            _uploadError = Session.T("Choose an image first.", "اختر صورة أولاً.");
            return;
        }

        _uploading = true;
        _uploadError = null;

        try
        {
            var created = await Api.UploadPatientImageAsync(
                Id,
                _uploadBytes,
                _uploadFileName,
                _uploadContentType,
                _uploadKind,
                _uploadTreatmentRecordId == Guid.Empty ? null : _uploadTreatmentRecordId,
                _uploadToothNumber,
                _uploadCapturedAt);

            _images = [.. await Api.GetPatientImagesAsync(Id)];

            if (_uploadPreviewUrl is not null)
            {
                _imageUrls[created.Id] = _uploadPreviewUrl;
            }

            Notifier.Success(Session.T("Image uploaded", "تم رفع الصورة"));
            CloseUpload();
        }
        catch (ApiException ex)
        {
            _uploadError = ex.Message;
        }
        finally
        {
            _uploading = false;
        }
    }

    private void OnCapturedChanged(ChangeEventArgs args)
    {
        if (DateTime.TryParse(args.Value?.ToString(), out var date))
        {
            _uploadCapturedAt = new DateTimeOffset(DateTime.SpecifyKind(date, DateTimeKind.Local));
        }
    }

    private void AskDeleteImage(PatientImageDto image)
    {
        _deleteImage = image;
        _deleteImageName = image.FileName;
        _imageConfirmOpen = true;
    }

    private async Task DeleteImageAsync()
    {
        _imageConfirmOpen = false;

        if (_deleteImage is not { } image)
        {
            return;
        }

        try
        {
            await Api.DeletePatientImageAsync(Id, image.Id);
            _images.RemoveAll(i => i.Id == image.Id);
            _imageUrls.Remove(image.Id);
            Notifier.Success(Session.T("Image deleted", "تم حذف الصورة"));
        }
        catch (ApiException ex)
        {
            Notifier.Error(Session.T("Delete failed", "فشل الحذف"), ex.Message);
        }
        finally
        {
            _deleteImage = null;
        }
    }

