@page "/services"
@inject ApiClient Api
@inject ClinicSessionState Session
@inject NotificationService Notifier

<PageTitle>@Session.T("Services", "الخدمات") · @Session.T("Al Noor Dental", "عيادة النور")</PageTitle>

<PageHeader Title="@Session.T("Dental services", "خدمات الأسنان")"
            Subtitle="@Session.T("Treatments and procedures offered by the clinic.", "العلاجات والإجراءات التي تقدمها العيادة.")">
    <Actions>
        <button type="button" class="btn btn-primary" @onclick="OpenCreate">
            <ClinicIcon Name="plus" Class="sm" /><span>@Session.T("New service", "خدمة جديدة")</span>
        </button>
    </Actions>
</PageHeader>

@if (_loading)
{
    <div class="grid grid-3">
        @for (var i = 0; i < 6; i++)
        {
            <div class="skeleton" style="height:150px;border-radius:14px"></div>
        }
    </div>
}
else if (_services.Count == 0)
{
    <div class="card">
        <EmptyState Icon="services" Title="@Session.T("No services yet", "لا توجد خدمات")"
                    Message="@Session.T("Define the procedures your clinic offers.", "عرّف الإجراءات التي تقدمها عيادتك.")">
            <ActionContent><button type="button" class="btn btn-primary" @onclick="OpenCreate"><ClinicIcon Name="plus" Class="sm" /> @Session.T("Add service", "إضافة خدمة")</button></ActionContent>
        </EmptyState>
    </div>
}
else
{
    <div class="grid grid-3">
        @foreach (var service in _services)
        {
            <div class="card">
                <div class="card-body">
                    <div class="flex-between mb-2">
                        <div class="stat-icon teal" style="margin:0;width:42px;height:42px"><ClinicIcon Name="tooth" /></div>
                        @if (service.IsActive)
                        {
                            <span class="badge success">@Session.T("Active", "نشط")</span>
                        }
                        else
                        {
                            <span class="badge muted">@Session.T("Inactive", "غير نشط")</span>
                        }
                    </div>
                    <h3>@service.Name</h3>
                    <p class="text-muted fs-sm mt-1" style="min-height:38px">@(string.IsNullOrWhiteSpace(service.Description) ? Session.T("No description", "لا يوجد وصف") : service.Description)</p>
                    <div class="divider"></div>
                    <div class="flex-between">
                        <div>
                            <div class="fs-xs text-soft">@Session.T("Price", "السعر")</div>
                            <div class="fw-700" style="font-size:1.15rem">@ClinicFormatting.Money(service.Price)</div>
                        </div>
                        <div class="row-actions">
                            <button type="button" class="btn btn-ghost btn-icon" title="@Session.T("Edit", "تعديل")" @onclick="() => OpenEdit(service)">
                                <ClinicIcon Name="edit" Class="sm" />
                            </button>
                            <button type="button" class="btn btn-danger-soft btn-icon" title="@Session.T("Delete", "حذف")" @onclick="() => AskDelete(service)">
                                <ClinicIcon Name="trash" Class="sm" />
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<Modal IsOpen="_formOpen" Title="@FormTitle"
       Subtitle="@Session.T("Service name, description and price", "اسم الخدمة والوصف والسعر")" OnClose="CloseForm">
    <ChildContent>
    @if (!string.IsNullOrWhiteSpace(_formError))
    {
        <div class="badge danger no-dot mb-2" style="display:flex;padding:10px 14px;border-radius:11px">
            <ClinicIcon Name="alert" Class="sm" /><span>@_formError</span>
        </div>
    }
    <div class="field">
        <label class="label">@Session.T("Name", "الاسم") <span class="req">*</span></label>
        <input class="input" @bind="_form.Name" placeholder="@Session.T("e.g. Teeth Whitening", "مثال: تبييض الأسنان")" />
    </div>
    <div class="field">
        <label class="label">@Session.T("Description", "الوصف")</label>
        <textarea class="textarea" @bind="_form.Description"></textarea>
    </div>
    <div class="field">
        <label class="label">@Session.T("Price (USD)", "السعر (دولار)") <span class="req">*</span></label>
        <input type="number" step="0.01" min="0" class="input" @bind="_form.Price" />
    </div>
    </ChildContent>

    <Footer>
        <button type="button" class="btn btn-ghost" @onclick="CloseForm">@Session.T("Cancel", "إلغاء")</button>
        <button type="button" class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">
            @if (_saving)
            {
                <span class="spinner"></span>
            }
            else
            {
                <ClinicIcon Name="check" Class="sm" />
            }
            <span>@Session.T("Save service", "حفظ الخدمة")</span>
        </button>
    </Footer>
</Modal>

<ConfirmDialog IsOpen="_confirmOpen"
               Title="@Session.T("Delete service", "حذف الخدمة")"
               Message="@Session.T($"Delete {_deleteTargetName}?", $"هل تريد حذف {_deleteTargetName}؟")"
               ConfirmLabel="@Session.T("Delete", "حذف")" CancelLabel="@Session.T("Cancel", "إلغاء")"
               OnConfirm="DeleteAsync" OnCancel="() => _confirmOpen = false" />

@code {
    private List<DentalServiceDto> _services = [];
    private bool _loading = true;

    private bool _formOpen;
    private bool _saving;
    private string? _formError;
    private Guid? _editingId;
    private DentalServiceFormRequest _form = new();

    private bool _confirmOpen;
    private Guid _deleteTargetId;
    private string _deleteTargetName = string.Empty;

    private string FormTitle => _editingId is null ? Session.T("New service", "خدمة جديدة") : Session.T("Edit service", "تعديل الخدمة");

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            var result = await Api.GetServicesAsync(1, 100, null);
            _services = result.Items ?? [];
        }
        catch (Exception)
        {
            _services = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private void OpenCreate()
    {
        _editingId = null;
        _form = new DentalServiceFormRequest { Price = 50 };
        _formError = null;
        _formOpen = true;
    }

    private void OpenEdit(DentalServiceDto service)
    {
        _editingId = service.Id;
        _form = new DentalServiceFormRequest
        {
            Name = service.Name,
            Description = service.Description,
            Price = service.Price,
        };
        _formError = null;
        _formOpen = true;
    }

    private void CloseForm()
    {
        _formOpen = false;
        _formError = null;
    }

    private async Task SaveAsync()
    {
        _formError = null;
        if (string.IsNullOrWhiteSpace(_form.Name))
        {
            _formError = Session.T("A service name is required.", "اسم الخدمة مطلوب.");
            return;
        }

        _saving = true;
        try
        {
            if (_editingId is null)
            {
                await Api.CreateServiceAsync(_form);
                Notifier.Success(Session.T("Service created", "تم إنشاء الخدمة"));
            }
            else
            {
                await Api.UpdateServiceAsync(_editingId.Value, _form);
                Notifier.Success(Session.T("Service updated", "تم تحديث الخدمة"));
            }

            CloseForm();
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            _formError = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private void AskDelete(DentalServiceDto service)
    {
        _deleteTargetId = service.Id;
        _deleteTargetName = service.Name;
        _confirmOpen = true;
    }

    private async Task DeleteAsync()
    {
        _confirmOpen = false;
        try
        {
            await Api.DeleteServiceAsync(_deleteTargetId);
            Notifier.Success(Session.T("Service deleted", "تم حذف الخدمة"));
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Notifier.Error(Session.T("Delete failed", "فشل الحذف"), ex.Message);
        }
    }
}
