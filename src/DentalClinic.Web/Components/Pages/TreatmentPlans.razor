    private void AskDeletePlan()
    {
        if (_selected is null)
        {
            return;
        }

        var plan = _selected;
        var performedCount = plan.Items.Count(i => i.Status is TreatmentRecordStatus.Performed);
        var detail = performedCount > 0
            ? Session.T(
                $"{performedCount} performed item(s) will be removed from the plan history. Issued invoices are not changed.",
                $"سيُزال {performedCount} عنصر منجز من سجل الخطة. لن تتغيّر الفواتير الصادرة.")
            : null;

        AskConfirm(
            Session.T("Delete plan", "حذف الخطة"),
            Session.T($"Delete \"{plan.Title}\"?", $"حذف \"{plan.Title}\"؟"),
            detail,
            Session.T("Delete", "حذف"),
            async () =>
            {
                // D-P5: the API requires an explicit confirmation
                // only when performed work exists.
                await Api.DeleteTreatmentPlanAsync(plan.Id, confirmPerformedItems: performedCount > 0);
                _selected = null;
                _sessions = [];
                _drawerOpen = false;
                Notifier.Success(Session.T("Plan deleted", "تم حذف الخطة"));
                await LoadAsync();
            });
    }

