    private async Task RunActionAsync(Func<Task> action, string successMessage)
    {
        try
        {
            await action();
            Notifier.Success(successMessage);
            await RefreshSelectedAsync();
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Notifier.Error(Session.T("Action failed", "فشل الإجراء"), ex.Message);
        }
        catch (Exception)
        {
            Notifier.Error(
                Session.T("Action failed", "فشل الإجراء"),
                Session.T("Unexpected error. Please try again.", "حدث خطأ غير متوقع. يرجى المحاولة مجدداً."));
        }
    }

    private void AskConfirm(string title, string message, string? detail, string confirmLabel, Func<Task> action)
    {
        _confirmTitle = title;
        _confirmMessage = message;
        _confirmDetail = detail;
        _confirmLabel = confirmLabel;
        _confirmAction = action;
        _confirmOpen = true;
    }

    private void CloseConfirm()
    {
        _confirmOpen = false;
        _confirmAction = null;
    }

    private async Task RunConfirmedAsync()
    {
        var action = _confirmAction;
        CloseConfirm();
        if (action is null)
        {
            return;
        }

        try
        {
            await action();
        }
        catch (ApiException ex)
        {
            Notifier.Error(Session.T("Action failed", "فشل الإجراء"), ex.Message);
        }
        catch (Exception)
        {
            Notifier.Error(
                Session.T("Action failed", "فشل الإجراء"),
                Session.T("Unexpected error. Please try again.", "حدث خطأ غير متوقع. يرجى المحاولة مجدداً."));
        }
    }

    private static decimal ItemAmount(TreatmentPlanItemDto item) =>
        item.Status is TreatmentRecordStatus.Performed ? item.Cost : item.EstimatedCost ?? 0;

