@namespace DentalClinic.Web.Components.Shared

<div class="tooth-grid mb-3">
    @foreach (var tooth in UpperTeeth)
    {
        <button type="button" class="tooth @(Value == tooth ? "selected" : "")" @onclick="() => Select(tooth)">@tooth</button>
    }
</div>
<div class="tooth-grid mb-3">
    @foreach (var tooth in LowerTeeth)
    {
        <button type="button" class="tooth @(Value == tooth ? "selected" : "")" @onclick="() => Select(tooth)">@tooth</button>
    }
</div>

@code {
    /// <summary>The selected FDI tooth number.</summary>
    [Parameter] public int Value { get; set; }

    [Parameter] public EventCallback<int> ValueChanged { get; set; }

    private static readonly int[] UpperTeeth = [18, 17, 16, 15, 14, 13, 12, 11, 21, 22, 23, 24, 25, 26, 27, 28];

    private static readonly int[] LowerTeeth = [48, 47, 46, 45, 44, 43, 42, 41, 31, 32, 33, 34, 35, 36, 37, 38];

    private Task Select(int tooth) => ValueChanged.InvokeAsync(tooth);
}
